label wwcrystalshard:
    $pink.otm.start_dynamic_event()
    play sound "fx/speech3.mp3"
    if persistent.pickedupcrystal == True:
        a2 "这里的水仍然闪闪发光"
        $pink.otm.end_dynamic_event()
        return
    a2 "...水里有一块闪亮的水晶？"
    a2 "感觉有点熟悉……但它可能毫无价值。"
    a2 "无论如何,你决定随身携带它,因为它很漂亮"
    $ pickedupcrystalshard = True
    $achievement.grant("familiar")
    init:
        $achievement.register("familiar")
        $achievement.sync()

    $achievement.sync()
    $achievement.grant("familiar")
    $ persistent.pickedupcrystal = True
    $pink.otm.end_dynamic_event()
    return

