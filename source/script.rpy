    play sound "va/1.ogg"
    e2 "... 我在哪里？"
    scene bg bedroom2
    show eyelayer with fade
    play sound "va/2.ogg"
    e2 "我..."
    scene bg bedroom2
    show eyelayer with fade
    $ renpy.pause(0.2, hard=True)
    scene bg bedroom2 with fade
    show hands with dissolve
    e2 ".."
    play sound "va/4.ogg"
    e2 "有些事..很痛。"
    show eyelayer with fade
    $ renpy.pause(0.2, hard=True)
    scene bg bedroom2 with fade
    show eyelayer with fade
    $ renpy.pause(0.2, hard=True)
    play sound "move.ogg"
    scene bg mirror with fade
    play sound "va/5.ogg"
    e2 "我--我不..."
    show eyelayer with fade
    $ renpy.pause(0.2, hard=True)
    scene bg mirror with fade
    show mirrors with dissolve
    "{p=1.5}{nw}"
    play sound "va/6.ogg"
    e2 "早些时候还没有这种削减。"
    e2 "..."
    play sound "va/7.ogg"
    e2 "我想我需要躺下"
    play sound "move.ogg"
    show eyelayer with fade
    hide mirrors with fade
    $ renpy.pause(0.2, hard=True)
    scene bg bedq
    show eyelayer with fade
    hide eyelayer with fade
    play sound "va/8.ogg"
    e2 "这... 不是我的床。"
    play sound "va/9.ogg"
    e2 "... 我刚才做梦了吗？"
    show eyelayer with fade
    hide eyelayer with fade
    play sound "va/10.ogg"
    e2 "我想我不能...熬夜...{p=2.1}{nw}"
    play sound "fall.ogg"
    show eyelayer with fade
    play music "truend2.ogg" fadein 2.0
    scene introblack with fade
    play sound "walk.ogg"
    $ renpy.pause(2, hard=True)
    " "
    play sound "va/11.ogg"
    if persistent.completed == True:
        qp2 "{color=#ffffff}我回来了！！你醒了吗,蜜蜂？{/颜色}"
    else:
        p2 "{color=#ffffff}我回来了！！你醒了吗,蜜蜂？{/颜色}"
    play music "sil.ogg"
    play sound "fx/hit.mp3"
    "{p=1.5}{nw} "
    $achievement.grant("room")
    init:
        $achievement.register("room")
        $achievement.sync()

    $achievement.sync()
    $achievement.grant("room")
    $ persistent.finishedgame = True
    return

