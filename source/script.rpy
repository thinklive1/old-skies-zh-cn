label endinganew:
    play sound "fx/speech2.mp3"
    scene grave with fade
    show leaves
    play music "endsong1.ogg"
    play sound "fx/speech3.mp3"
    f4 "...你看看你的坟墓"
    play sound "fx/speech3.mp3"
    f4 "数千年后,仍然留在原地,站在这里"
    play sound "fx/speech3.mp3"
    f4 "...终于到了放手的时候了,这有点不真实"
    play sound "fx/speech3.mp3"
    f4 "...你最后一次想知道他们现在过得怎么样"
    play sound "fx/speech3.mp3"
    f4 "也许有一天你会以某种方式再次见面"
    play sound "fx/speech3.mp3"
    f4 "...但现在, "
    stop music fadeout 2.0
    play sound "fx/speech3.mp3"
    f4 "..."
    play sound "fx/speech3.mp3"
    $ config.rollback_enabled = False
    f4 "你俯下身子,捡起剩下的你。"
    play movie "endcredits.webm"
    $ renpy.pause(113, hard=True)
    scene introblack
    stop movie
    scene introblack
    $ renpy.block_rollback()
    $ config.rollback_enabled = True
    play sound "fx/speech3.mp3"
    $achievement.grant("anew")
    init:
        $achievement.register("anew")
        $achievement.sync()

    $achievement.sync()
    $achievement.grant("anew")
    f4 "...你不会忘记"
    $ MainMenu(confirm=False)()


