            play music "bottomfloor.ogg" fadein 2.0
            $ pink.otm.go_to_map(target_map='skyscraper_floor1.json', x_coord=5, y_coord=4)
            $pink.otm.end_dynamic_event()
            return

        "五.":
            play sound "fx/speech.mp3"
            a2 "你说大厅里有 5 个人。"
            g4 "……..."
            g4 "…………..."
