init python:

    txt1 = ""
    txt2 = ""
    txt3 = ""

    def word_effect(txt):
        global txt1, txt2, txt3
        txt1 = txt
        txt2 = ""
        txt3 = ""
        i = 2
        for letter in txt:
            i += 1
            if i % 2 == 0:
                txt2 += "{font=unif.otf}" + letter + "{/font}"
                # Instead of "size" any text tag can be applied here,
                # see: http://www.renpy.org/doc/html/text.html#styling-and-text-tags
                txt3 += "{size=-2}{font=unif.otf}" + letter + "{/size}{/font}"
            else:
                txt2 += "{size=-2}{font=unif.otf}" + letter + "{/size}{/font}"
                txt3 += "{font=unif.otf}" + letter + "{/font}"

