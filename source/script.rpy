label wwocean:
    $pink.otm.start_dynamic_event()
    play sound "fx/speech3.mp3"
    a2 "你可以用脚趾感受到海水"
    a2 "天气很冷……但看起来很漂亮"
    if persistent.bunny1 == True:
        a2 "...你想去游泳"
        menu:
            a2 "游泳吗？"
            "去游泳":
                play sound "fx/splash.mp3"
                a2 "你决定下水"
                scene introblack with fade
                $ renpy.pause (0.7)
                play music "swimming_music.ogg" fadein 2.0
                $ pink.otm.go_to_map(target_map='ocean_s.json', x_coord=4, y_coord=5)
                $pink.otm.end_dynamic_event()
                return

            "现在不行":
                play sound "fx/speech.mp3"
                a2 "...可能太冷了"
                $pink.otm.end_dynamic_event()
                return

    $pink.otm.end_dynamic_event()
    return
