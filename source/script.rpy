init python:
    map_zoomed_out = False
    map_zoomed_in_further = False

    def reset_all_zoom_flags():
        global map_zoomed_out, map_zoomed_in_further
        map_zoomed_out = False
        map_zoomed_in_further = False

    def toggle_zoom_out():  # R1
        global map_zoomed_out, map_zoomed_in_further
        if map_zoomed_out:
            pink_otm_current_camera.set_zoom(1.6)  # back to default
            reset_all_zoom_flags()
        else:
            pink_otm_current_camera.set_zoom(0.7)
            map_zoomed_out = True
            map_zoomed_in_further = False

    def toggle_zoom_in_further():  # L1
        global map_zoomed_out, map_zoomed_in_further
        if map_zoomed_in_further:
            pink_otm_current_camera.set_zoom(1.6)  # back to default
            reset_all_zoom_flags()
        else:
            pink_otm_current_camera.set_zoom(3.0)
            map_zoomed_in_further = True
            map_zoomed_out = False
init python:
    key_m_pressed = False
    map_zoomed_out = False

    def map_open():
        global map_zoomed_out
        if not map_zoomed_out:
            pink_otm_current_camera.set_zoom(0.7)
            map_zoomed_out = True

    def map_close():
        global map_zoomed_out
        renpy_exports.notify("Unzooming")
        if map_zoomed_out:
            pink_otm_current_camera.set_zoom(1.6)
            map_zoomed_out = False

