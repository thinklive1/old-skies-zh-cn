label wwoldmanbattle:
    $pink.otm.start_dynamic_event()
    play sound "talk_male.ogg"
    if persistent.takenplushie == True:
        g6 "嘿！"
        g6 "保持忙碌？"
        g6 "... 噢！我看你去拿了,嘿？"
        g6 "好好照顾它！！"
        g6 "...如果你想让我再次保留它,请随时告诉我"
        g6 "..."
        g6 "...但希望我不再需要了。"
        $pink.otm.end_dynamic_event()
        return
    if persistent.shrinecoin == True:
        g6 "嘿！"
        g6 "保持忙碌？"
        if persistent.resetanew == True:
            g6 "...你又违背了诺言。。"
            g6 "啊,好吧！这次也许吧？"
        g6 "好吧,继续吧！"
        a2 "....他们挥手示意你离开"
        $pink.otm.end_dynamic_event()
        return
    if persistent.oldmanwon == True:
        g6 "哇！"
        g6 "你真的做到了！"
        a2 "老人呼吸急促"
        g6 "那是一次很好的锻炼,嘿？"
        g6 "嗯,承诺就是承诺！"
        g6 "我会给你这枚硬币..."
        g6 "你最好也信守诺言！"
        $achievement.grant("quick footed")
        init:
            $achievement.register("quick footed")
            $achievement.sync()

        $achievement.sync()
        $achievement.grant("quick footed")
        play sound "fx/inp.mp3"
        a2 "他们给你闪亮的硬币"
        $ config.rollback_enabled = False
        $ persistent.coins += 1
        $ show_coins = True
        show screen coin_display
        $ persistent.shrinecoin = True
        $ config.rollback_enabled = False
        g6 "坚持住！！"
        a2 "你感谢老人"
        g6 "...很高兴再次见到你。"
        g6 "...这次你最好这样做,嘿？"
        a2 "....他们挥手示意你离开"
        $pink.otm.end_dynamic_event()
        return
    if persistent.talkedoldman == True:
        g6 "你有点生锈了,不是吗？"
        a2 "他们轻轻地笑了"
        g6 "嗯... 我会在这里待一整天……"
        g6 "那么你准备好进行第二轮了吗？"
        g6 "也许这次你能跟上！！啊哈！"
        menu:
            a2 "又挑战老人了？"
            "战斗":
                play sound "fx/speech3.mp3"
                stop music
                g6 "好吧！让我们看看你是否进步了！"
                jump battle_oldman
            "现在不行":
                play sound "talk_male.ogg"
                g6 "退缩？"
                g6 "如果没有这个,你就无法超越我的学生！"
                a2 "他们再次闪现闪亮的硬币"
                g6 "准备好后就回来,听见了吗？"
                $pink.otm.end_dynamic_event()
                return
    g6 "... 我看你已经回来了。"
    g6 "已经有一段时间了,不是吗..."
    g6 "几年,谁知道呢……"
    a2 "你可以看到他们上下打量你"
    g6 "... 看来你又输了,是吗？"
    a2 "他们似乎暗自笑"
    g6 "你的状况比我记忆中的还要糟糕！"
    g6 "嗯... 我很遗憾地说... 我没有你想要的东西"
    g6 "...."
    g6 "但我的学生却这么做了！！我刚才把它搬到那里保管！"
    g6 "所以去问他们吧！他们会引导你去做这件事！"
    g6 "他们正在这里北边的小建筑集合处！万一你...忘记了..."
    a2 "他们又低声笑了。。"
    a2 "...你不确定老人指的是什么,但你选择过去"
    play sound "talk_male.ogg"
    g6 "等一下！等一下！等一下！你是不是很渴望啊！"
    g6 "我的学生不会随便给任何老无名小卒访问权限！你得先证明自己！"
    a2 "老人向空中抛掷一枚闪亮的硬币"
    g6 "... 向他们展示这个,他们就会让你直接通过。但要得到它--"
    $ persistent.talkedoldman = True
    stop music
    g6 "你需要证明你可以对付像我这样的老人！"
    $ persistent.anewbattle = True
    $ renpy.notify("🎧 reset ft. eserine (R O C K Y's Nite 2 da Kore Remix) - vai5000")
    play music "resetbattle.ogg" fadein 2.0
    $ persistent.fixcheck = True
    $pink.otm.leave_otm()
    jump oldman_battle

