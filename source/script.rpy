label endingX1:
    scene bg white with fade
    stop music
    if persistent.round1 == True:
        play sound "fx/speech.mp3"
        n2 "你内心有些东西变了。"
        play sound "fx/speech.mp3"
        n2 "...你为什么选择一遍又一遍地重温这些时刻？"
        play sound "fx/speech.mp3"
        n2 "..."
        play sound "fx/speech.mp3"
        n2 "必须有一个逃避这一切的方法。"
        play sound "fx/speech.mp3"
        n2 "你拒绝继续。"
        jump endingcc
    play music "sec2.ogg"
    n2 "..."
    if persistent.kiryu == True:
        show girlk with dissolve
    else:
        show girl1 with dissolve
    play sound "fx/speech.mp3"
    y2 "没关系"
    n2 "你审视自己分裂的形象"
    n2 "它对你说话"
    play sound "fx/speech.mp3"
    y2 "你现在在这里很安全"
    show leaves with dissolve
    play sound "fx/speech.mp3"
    y2 "我会确保这一点"
    scene introblack with fade
    stop music
    play sound "fx/speech.mp3"
    y2 "从现在开始我会和你在一起"
    play sound "fx/speech.mp3"
    y2 " "
    play sound "fx/speech.mp3"
    y2 "总是"
    jump endingcc

label endingcc:
    $ persistent.epilogue = True
    $ persistent.round2 = True
    $ persistent.round1 = False
    if persistent.statx == True:
        n2 "这是你之前看到的数字吗？"
        n2 "你看到脚下出现了一道绿光……"
        play sound "fx/in2.mp3"
        show imgxx with dissolve
        y2 "...哦？"
        y2 "我想我很快就会见到你。"
        scene introblack
        if persistent.epilogue1 != True:
            nx "... EPILOGUE 已出现在主菜单上"
            $ persistent.epilogue1 = True
        $ renpy.pause (0.8)
        if persistent.achsalv != True:
            play sound "fx/steam.ogg"
            $ renpy.notify("ACHIEVEMENT UNLOCKED - salvation")
            $ persistent.achsalv = True
        $achievement.grant("salvation")
        init:
            $achievement.register("salvation")
            $achievement.sync()

        $achievement.sync()
        $achievement.grant("salvation")
        play sound "fx/steam.ogg"
        $ renpy.notify("ACHIEVEMENT UNLOCKED - true salvation")
        $ persistent.achtruesal = True
        $achievement.grant("true salvation")
        init:
            $achievement.register("true salvation")
            $achievement.sync()

        $achievement.sync()
        $achievement.grant("true salvation")
        if persistent.achtruesal != True:
            play sound "fx/steam.ogg"
            $ renpy.notify("ACHIEVEMENT UNLOCKED - true salvation")
            $ persistent.achtruesal = True
        $achievement.grant("true salvation")
        init:
            $achievement.register("true salvation")
            $achievement.sync()

        $achievement.sync()
        $achievement.grant("true salvation")
        $ persistent.statx = False
        $ persistent.secret_end = True
        $ MainMenu(confirm=False)()
    else:
        n2 "..."
    scene introblack with fade
    if persistent.epilogue1 != True:
        nx "... EPILOGUE 已出现在主菜单上"
        $ persistent.epilogue1 = True
    $ renpy.pause (0.8)
    if persistent.achsalv != True:
        play sound "fx/steam.ogg"
        $ renpy.notify("ACHIEVEMENT UNLOCKED - salvation")
        $ persistent.achsalv = True
    $achievement.grant("salvation")
    init:
        $achievement.register("salvation")
        $achievement.sync()

    $achievement.sync()
    $achievement.grant("salvation")
    $ renpy.pause (0.8)
    $ persistent.secret_end = True
    $ MainMenu(confirm=False)()

