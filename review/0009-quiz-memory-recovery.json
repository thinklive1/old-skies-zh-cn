{
  "allow_tag_repair": true,
  "changes": {
    "8510": "说好的，我拿硬币跟你换这些贝壳！",
    "8512": "给你！",
    "8514": "作为交换，你交出收集到的贝壳。",
    "8525": "作为交换，你交出收集到的 10 枚贝壳。",
    "8533": "再找一枚，就能换了！",
    "8561": "进展不错！",
    "8583": "各种贝壳都会被冲到海滩上……总能找到一两枚好看的！",
    "8592": "这样吧，至少给我找 10 枚，我就拿这枚硬币跟你换！",
    "8596": "……你决定，留意一下好看的贝壳。",
    "8617": "托你的福，我们连奖品都发完了。",
    "8622": "你斜眼看了看对方。",
    "8626": "快刷卡，或者投币，再来动动脑子吧！",
    "8637": "所以……我们把整栋楼改成了答题挑战！！！答题多好玩！！！",
    "8640": "等等，有奖品！！只要你能一路答到顶层……",
    "8642": "不过，现在不告诉你是什么，不然就没惊喜了！",
    "8656": "是、是五吗？不……四？",
    "8659": "是、是四吗？不……二？",
    "8662": "是、是三吗？不……不是三……从来就不是三……",
    "8663": "恭喜，第 1 题答对了！",
    "8674": "我……从没选对过这个数字。",
    "8675": "我一次次选自己的幸运数字三，可每次都被送回楼下。",
    "8687": "……你该不会反复读档，靠试答案猜出来的吧？",
    "8693": "多了这些植物，感觉好不少。",
    "8696": "……哦，那些橙色？",
    "8730": "{size=*3}去！！！{/size}",
    "8732": "……记、记住……顶层……",
    "8733": "来、来这里的……你……",
    "8735": "谁、谁……你是……",
    "8737": "你也……想解开……{size=*0.5}测验……{/size}",
    "8740": "你、你……知道自己是谁吗？……谁是……{size=*2}你？{/size}",
    "8742": "那我……得把……你送回……{size=*0.5}最底下……{/size}",
    "8744": "因、因为……要是你……知道……",
    "8745": "{size=*0.5}要是你知道……{/size}",
    "8749": "你……{size=*2}你？{/size}可以再试一次……",
    "8752": "{size=*2}你是谁？{/size}",
    "8753": "{size=*0.5}你是谁{/size}",
    "8755": "但、但也许……你开始……想起来……",
    "8759": "{size=*3}想明白！！！！！{/size}",
    "8760": "{size=*3}逃出去！！！！！{/size}",
    "8763": "等一下！！！等、等一下！！！！！",
    "8767": "第、第 6 题……是……不可能的！！！可是——",
    "8768": "说这个。说。说。对{size=*0.5}他们{/size}说。",
    "8769": "然、然后你就能走。就能拿到……奖品！！！！！",
    "8770": "可、可是……不是他们给你的那个——……",
    "8772": "和、和这里一样的入口。可，不在这里。不在这里……",
    "8775": "……去吧！你、你答对了！！！还记得吗？下一层！！别、别忘了……去拿你的奖品……",
    "8776": "继、继续往前——",
    "8777": "对方转过身，背对着你。",
    "8780": "……其实吧……有人想要一层‘海滩主题楼层’。",
    "8782": "结果他们偏要：搬沙子！再灌上来源合乎道德的海水！！",
    "8803": "也许，只是个普通楼层。毕竟，这本来就是栋楼。",
    "8812": "我猜，这层是他们打理得最勤的地方。",
    "8837": "走之前，别忘了把奖励都拿上！！",
    "8852": "给你……特别奖品！！而且，有两个！！！",
    "8857": "你面无表情，显然原本还期待更多。",
    "8859": "等等……",
    "8864": "……你拿到了一条黑色领带。",
    "8867": "你觉得有点……不过如此。",
    "8891": "记得帮我送过去哦！就指望你了！",
    "8892": "对方住在海边的房子里，别忘啦！",
    "8899": "对方指了指地上的盒子。",
    "8901": "就住在海边！！正好，去换换环境嘛！",
    "8906": "你记下这件事，等有机会就把东西送去。",
    "8911": "……哦？给朋友的东西，你帮我送过去了吗？",
    "8925": "你把东西递过去……那是一个透明的绿色卡带。",
    "8926": "似乎是某种掌上游戏机用的。",
    "8928": "你正要离开——",
    "8930": "给你——算是帮忙送东西的谢礼！你穿一定好看，我还有多的！",
    "8936": "如果你还要回去找我的朋友，能把这个也带过去吗？一点谢意！",
    "8938": "你记下这件事，等有机会就帮忙带回去。",
    "8949": "姑娘，近来可好？",
    "8951": "瞧瞧这模样。",
    "8953": "瞧瞧你，姑娘，你想起来了！！！好样的！",
    "8956": "那就告辞啦！祝你好运！",
    "8958": "去找过我安排在那里的小伙子了吗？",
    "8961": "就是中间空了一块的那栋！！你知道是哪栋！！",
    "8962": "快去吧！这一回，你就快到了！！",
    "8974": "……也许，终于是时候了吧？",
    "8976": "不过——还缺一点点你。而我——我知道在哪儿！嘿嘿！",
    "8977": "给，拿着吧，姑娘。",
    "8983": "给我安排在小镇西边的小伙子看看这张照片，他就会放你过去！",
    "8985": "祝你好运，姑娘！剩下的那个你，就在下面等着！！",
    "8996": "我看，你还缺一点自己……也许，再四处找找比较好！",
    "9005": "祝你好运，姑娘！也别忘了，找齐剩下的自己！",
    "9010": "还没到能认清自己的程度——不过，对我来说，已经够接近啦。懂吧？",
    "9014": "继续找。我敢肯定，你还留了不少东西！！哈哈！",
    "9026": "等想起来更多，再回来吧！不回来也行，我不介意。",
    "9030": "再仔细找找！你这找东西的本事，也太差了吧？",
    "9031": "要是你能看见现在的自己，准得羞愧！！！",
    "9033": "你把东西留在四处了！去找出来！！",
    "9105": "不过——我得给你传句话。还是你自己留下的呢！",
    "9117": "啊哈！我们骗谁呢！！",
    "9130": "听说，只有师父亲近的人才准进去。",
    "9132": "内、内室可以从左侧通道下面进去。",
    "9135": "欢、欢迎回来！！见过师父了吗？",
    "9138": "你、你打败师父了？",
    "9145": "欢、欢迎！！这里是学徒神社！！",
    "9146": "没见过师父的话，他就在南边的神社里！！",
    "9159": "最棒的是，我和他——",
    "9161": "我们一起住在这里！！就像永远不会结束的留宿派对！",
    "9169": "他不怎么肯认真跳，动作也老是提前。",
    "9175": "我还以为，北边会比较清静……",
    "9189": "……啊！！你全找到了！",
    "9194": "有空再来，等长好了，让你尝尝！！",
    "9198": "抱歉，姑娘，给你！！",
    "9204": "……可没洒水壶？？？洒水壶也得有啊！！",
    "9206": "哎呀，这可怎么办？看来得去别处找找！！",
    "9207": "你肯定能找到！！找到了，就回来！！",
    "9233": "缺的东西，应该都在你拿种子的那家店里！",
    "9235": "……肥料应该还在，可洒水壶在哪儿，我就不知道了！",
    "9237": "快去吧！我等着！！",
    "9251": "缺的东西，应该都在你拿肥料的那家店里！",
    "9253": "……种子应该还在，可洒水壶在哪儿，我就不知道了！",
    "9257": "需要的东西，你都帮我拿来了？",
    "9266": "还有洒水壶也得换一个，现在这个已经锈得不成样了……",
    "9269": "我会——呃——报酬你！报……报答？报——",
    "9270": "你提醒对方，应该说‘给你报酬’。",
    "9274": "上次去的时候，东西已经剩不多了，可那里还是最有希望！！而且全免费！",
    "9283": "没记错的话……是神社旁边那栋白色的房子。",
    "9314": "我倒是乐意！！",
    "9330": "要、要现在交换吗？",
    "9344": "要、要交换吗？",
    "9356": "你、你找到那条丝带了吗？",
    "9358": "没找到丝带，就不换！！",
    "9365": "你问她，愿不愿意把洒水壶给你——",
    "9369": "我——如果你能给我一条丝带，也许可以换……？",
    "9371": "拿到了，我们就交换！！",
    "9401": "看来，又快到那个时候了。",
    "9405": "给你。",
    "9409": "你会再次想明白的。",
    "9417": "……我……在这里，还算知足。",
    "9481": "……你望向占着另一半座位的植物。它狠狠瞪了你一眼。",
    "9483": "……至少，第一层要这样……我从来没走过更远！"
  },
