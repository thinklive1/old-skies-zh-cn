{
  "changes": {
    "3652": "也许，这里的自来水还能补补铁？",
    "3653": "它似乎有点嫉妒旁边那株盆栽。",
    "3654": "这里堆满了空纸箱。",
    "3663": "沙发看起来已经用了很久。",
    "3676": "也许是晕得厉害，从花盆里掉出来了。",
    "3687": "这里摆着几块隔板。",
    "3701": "哪怕伸直身子躺上去，你大概也够不到另一头。",
    "3708": "……有株植物，正一点点吞没这个小架子。",
    "3709": "……你决定不打扰它。",
    "3711": "……植物把它盖满了，你甚至认不出这是台什么设备。",
    "3713": "……你有点想偷偷尝一口。",
    "3717": "到处都撒了一点。",
    "3719": "……至少，有鱼的时候应该是。",
    "3721": "只剩下大概一盒鱼食。",
    "3729": "看着一碰就会碎。",
    "3736": "外面透进来不少光。",
    "3737": "……这里的灯全坏了，这是唯一的光源。",
    "3745": "这是一张软乎乎的沙发。",
    "3749": "……你觉得它已经不工作了。",
    "3751": "它现在‘烤’的，只有铁锈。",
    "3756": "不用打开，你也觉得里面已经长满植物了。",
    "3766": "它待在房间角落，像是就该待在那里。",
    "3767": "这些临时隔板，倒是把另一边挡得严严实实。",
    "3768": "这株植物没住在花盆里。",
    "3772": "……不行，这不是你的床。",
    "3775": "隔板后面放着某种设备。",
    "3780": "小储藏室里摆满了桶。",
    "3781": "……一股腐臭味从桶里飘出来。",
    "3782": "应该是给外面的农场用的。",
    "3786": "它大概在想，为什么自己不能像其他植物那样，直接长在地上。",
    "3788": "已经有些破旧了。",
    "3799": "……大概不该随便翻动。",
    "3803": "……门把手都锈住了。你决定不碰它。",
    "3814": "隔板已经有些磨损，不过仍很结实。",
    "3815": "墙上有幅大画。",
    "3816": "大概很漂亮……可全被植物遮住，看不清了。",
    "3818": "它们看起来很开心。",
    "3826": "它似乎很想住进花盆里。",
    "3831": "这里摆着几段隔板。",
    "3833": "现在这里看着更像一株植物，已经不像水槽了。",
    "3852": "这里只有窗外透进来的光。",
    "3854": "隔板正在练习：一动不动。",
    "3855": "暖风机训练时，大概也得节省体力。",
    "3857": "这把剑，正在努力当好一把剑。",
    "3859": "你想，它们是不是在学游泳。",
    "3864": "指的是往里走的那些房间。",
    "3870": "就算装满了，里面也未必有你要的东西。",
    "3872": "……看到按钮上长着植物，你决定不碰它。",
    "3878": "……等等。",
    "3880": "这里的货架上摆着各种商品。",
    "3883": "仔细一看，只是些泥土。",
    "3886": "……你觉得还是算了。",
    "3887": "看来，是在这里付款。",
    "3888": "也许该绕到旁边，和收银员说句话。",
    "3889": "前面孤零零地放着一辆购物车。",
    "3893": "除了点泥土，架子上什么都没有。",
    "3898": "……还是趁没改变主意，别再盯着那支可爱的笔看了。",
    "3900": "想把笔拿走吗……",
    "3901": "你其实用不着它……也想不出能拿它做什么……",
    "3908": "你想把这支可爱的笔留在这里……",
    "3910": "……万一别人也想要呢……？",
    "3915": "……你拿起了这支可爱的笔。",
    "3919": "你把笔留在原处。",
    "3951": "……拿走也没什么坏处，对吧？",
    "3956": "……少一支笔，应该没人会在意……",
    "3973": "架子上贴着牌子：‘洒水壶：已售罄’",
    "3977": "你拿起一袋，带在身上。",
    "3991": "你为它们感到骄傲。它们隔开空间的工作，做得真不错。",
    "3992": "小桌上摆着一个精致的花盆。",
    "3993": "它望着你，好像巴不得被打碎。",
    "3994": "它以为自己藏在隔板后面，可你还是找到了它。",
    "3995": "你找到了花盆。",
    "3999": "它似乎正努力做一株植物。",
    "4005": "它们纹丝不动。",
    "4013": "这里……只有一个打开的柜子。",
    "4014": "柜子正中间放着一只小毛绒玩具……在这里显得有些格格不入。",
    "4015": "……不知为什么，你被它吸引，伸手将它拿了起来。",
    "4016": "指尖传来的毛绒触感……如此熟悉。",
    "4018": "也许，这就是老人说的那件东西……",
    "4023": "绿色的宝石闪闪发亮，映出你的模样。",
    "4024": "……而且……你认出了倒影里的人。",
    "4026": "眼泪开始涌出来。你知道，自己为什么又回到这里了。",
    "4027": "是时候，再试一次了。",
    "4028": "……也许这一次，你会有足够的勇气。",
    "4029": "你攥紧项链。记忆里，你已无数次把它留在这里。",
    "4030": "也曾无数次拿起它，无数次再次感受到这一切。",
    "4032": "你该去那个人的墓前，就在这里的北边。",
    "4033": "你该道别了。",
    "4046": "这把钥匙，应该是开……",
    "4048": "现在，抽屉里只剩下一些杂乱的文件。",
    "4052": "你的东西收在这些抽屉里。",
    "4060": "你的餐桌已经有些旧了。",
    "4068": "这里面居然长着一整棵树？！",
    "4069": "你朝栅栏另一边望去。",
    "4070": "……你也不知道，这栅栏明明能绕过去，为什么还要这样。",
    "4074": "牌子上写着：‘准备回答第 2 题！大概吧！’",
    "4076": "牌子上写着：‘准备回答第 4 题！没记错吧？？’",
    "4080": "……它已经彻底乱了套。",
    "4086": "这里摆着一个华丽的花盆。",
    "4105": "这里还不够高，远处的建筑挡住了视线。不过，脚下的街道倒看得很清楚。",
    "4107": "现在，你勉强能看见附近的屋顶了。",
    "4109": "已经够高了，远处的景色尽收眼底。",
    "4111": "这里开始高得让你不太自在。",
    "4113": "……真的很高了。下方的人，显得有点过分渺小。",
    "4115": "从这里几乎能看见一切。自己的渺小，让你有点害怕。",
    "4143": "地上散落着一些贝壳。",
    "4144": "……这些大概还是别拿。",
    "4146": "说实话，你也没指望还会有什么。",
    "4153": "……你这才渐渐意识到，那已经是多久以前了。",
    "4154": "一道金属围栏，防止人掉进水里。",
    "4155": "金属围栏挡住了前面的路。",
    "4165": "你想象着，先把一条腿跨过去……再把另一条腿跨过去……然后……",
    "4169": "现在拦住你的，只剩身体上的障碍。因为在心里，你早已站到了另一边。",
    "4170": "桌边放着一把空椅子……你不明白，接待员为什么还站着。",
    "4176": "你不知道，它在这里放了多久。",
    "4177": "……你决定不碰它。",
    "4183": "这是一根电线杆。",
    "4184": "你觉得，它已经很久没工作了。",
    "4185": "这是一根电线杆，比一般的更高。",
    "4187": "{font=cc2.ttf}你的名字{/font}的住所",
    "4190": "或按下手柄的左、右肩键……",
    "4195": "藤蔓沿着侧面攀生。",
    "4199": "你朝栅栏另一边望去……那里长着庄稼。",
    "4200": "你朝长满植物的栅栏另一边望去……那里长着庄稼。",
    "4201": "你朝栅栏另一边望去……地上好像放着一个箱子。",
    "4203": "这里长着某种作物，似乎还没到收获的时候。",
    "4206": "这里长着某种作物……它似乎会自己照顾自己。",
    "4212": "你记得，曾偶尔和那个人在这里买些零食。",
    "4213": "东西很便宜，算不上好吃……可有那个人陪着，似乎也没那么糟。",
    "4218": "这让你有借口多陪对方一会儿，所以你也不介意。",
    "4228": "盒子里也积满了灰。",
    "4246": "其中一扇窗户被木板封住了。",
    "4248": "地板上有几处压痕，你猜，那些地方以前也放着架子。",
    "4253": "已经过去{font=cc2.ttf}好几年{/font}了。我不知道该怎么办。",
    "4254": "每天总是{font=cc2.ttf}一样，一遍又一遍{/font}。每天都是。",
    "4255": "我不知道该怎么逃出去。我正在努力。",
    "4256": "{font=cc2.ttf}我在想……{/font}会不会和我有关？",
    "4257": "我连自己的{font=cc2.ttf}名字{/font}都开始忘记了。",
    "4258": "我不知道，还能这样撑多久……",
    "4259": "我只希望，{font=cc2.ttf}未来的我，{/font}……不要忘记。求你。",
    "4260": "{font=cc2.ttf}你的名字 NONX{/font}。",
    "4261": "末尾的日期已经模糊得看不清，但这张纸条显然写于很久很久以前。",
    "4263": "……放回纸条时，某个念头在你脑海里挥之不去。",
    "4268": "河道到了桥边，渐渐收窄。",
    "4272": "河流一路延伸，比你从这里望见的还要远。",
    "4280": "你挤不过去。",
    "4291": "但它很漂亮，你还是决定带走。",
    "4293": "如果不会滑下去，倒是能坐在上面……",
    "4295": "你小心不让脚撞上它。",
    "4306": "海水很冷……可看起来很美。",
    "4320": "要不是天这么阴，这里倒是个坐着歇歇的好地方。",
    "4325": "看起来，从前经常有人坐。",
    "4329": "那天就像今天，也是阴天。",
    "4330": "周围没有别人。那一刻，也说不上有什么特别。",
    "4331": "可它就发生在这里，发生在你们并肩坐着的这张长椅上。",
    "4334": "似乎已经很久很久，没人坐过了。",
    "4336": "这是个垃圾桶……你并不想翻里面的东西。",
    "4337": "通往{font=cc2.ttf}城市{/font} >",
    "4341": "{font=cc2.ttf}你的邻居{/font}的仓库",
    "4342": "……似乎是存放农事用品的地方。",
    "4347": "<< {font=cc2.ttf}农场与乡间{/font}",
    "4350": "显然早已开不了了，发动机里大概都长出了植物。",
    "4356": "里面……有垃圾。理所当然。",
    "4358": "你记得，许多个下午都把喝完的饮料扔在这里。",
    "4359": "放学后，你总会和那个人来这里买杯饮料。",
    "4365": "你从没见过长成这样的植物。",
    "4366": "……现在倒是见过了。你开始觉得它也挺正常。",
    "4370": "……看来，你错过这场促销好几年了。",
    "4371": "几……百年……",
    "4374": "真是个漂亮的小湖。",
    "4376": "宣传的是附近餐厅推出的新菜。",
    "4377": "要不要试试？如果它还在卖的话……",
    "4380": "铭牌上的字已经看不清了……",
    "4381": "{font=cc2.ttf}空置房屋{/font}",
    "4384": "{font=cc2.ttf}空置建筑{/font}",
    "4389": "……至少，曾经是。",
    "4400": "{font=cc2.ttf}通往小镇北部{/font}",
    "4401": "牌子指着这边，通往小镇的北端。",
    "4402": "这里似乎可以住宿。",
    "4405": "{font=cc2.ttf}杂货{/font}商店",
    "4411": "……其实很容易绕过去。",
    "4414": "杆子上似乎贴着公交时刻表。",
    "4415": "……按上面写的，下一班车再过几分钟就到……",
    "4422": "窗户太暗，根本看不清里面……",
    "4431": "（注意：每次测验收费 5 美元，感谢理解。）",
    "4432": "{font=cc2.ttf}公交站在此{/font}",
    "4434": "房子周围围着一道浓密的树篱。",
    "4436": "花园周围围着一道浓密的树篱。",
    "4439": "和周围其他植物不同，这一株似乎是假的。",
    "4441": "气味……很冲……",
    "4451": "牌子正下方的那块地砖，制造于 2027 年",
    "4453": "箱子上贴着小标签。",
    "4458": "制作于 2067 年。",
    "4465": "这里有张……桌子？上面嵌着一块小铭牌。",
    "4468": "这是接待台……总的来说，保存得还算不错。",
    "4469": "这是接待台……柜台后面的电脑，显然早已坏了。",
    "4470": "难怪这家游戏厅让人免费玩……",
    "4472": "海报宣传着游戏厅新进的一款街机游戏，是个赛车游戏。",
    "4473": "海报在宣传什么……？被植物盖住了，看不太清。",
    "4478": "这里有个垃圾桶……你不想伸手进去翻。",
    "4482": "你不知道，那些游戏后来到底有没有上市。",
    "4486": "你觉得，这里已经很久没人来了。",
    "4497": "项链上嵌着一颗蓝宝石，在仅有的一丝光线里微微闪烁。",
    "4498": "……这么漂亮，实在不该被遗留在这里……"
  },
