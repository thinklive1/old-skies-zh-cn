    "4975": {
      "original": "控制停止工作！！",
      "target": "操作突然失灵了！！",
      "file": "script.rpy",
      "line": 18129
    },
    "5002": {
      "original": "... 你爆炸了,迷路了...",
      "target": "……你的车炸了，比赛也输了……",
      "file": "script.rpy",
      "line": 18199
    },
    "5023": {
      "original": "而且...来帮忙的乘务车爆炸了。",
      "target": "而且……赶来救援的车也炸了。",
      "file": "script.rpy",
      "line": 18241
    },
    "5044": {
      "original": "这很容易！你先进来的！",
      "target": "太轻松了！你拿了第一！",
      "file": "script.rpy",
      "line": 18299
    },
    "5052": {
      "original": "你先进来的！",
      "target": "你拿了第一！",
      "file": "script.rpy",
      "line": 18316
    },
    "5053": {
      "original": "其他赛车手则被抛在尘土中。",
      "target": "其他车手，只能在后面吃灰。",
      "file": "script.rpy",
      "line": 18317
    },
    "5086": {
      "original": "..它是平的",
      "target": "……已经没气了。",
      "file": "script.rpy",
      "line": 18396
    },
    "5092": {
      "original": "..有点起泡..不过没有太多起泡..",
      "target": "……还有点气泡……不过，已经不多了……",
      "file": "script.rpy",
      "line": 18415
    },
    "5110": {
      "original": "...有一点海风",
      "target": "……有一点海风的味道。",
      "file": "script.rpy",
      "line": 18472
    },
    "5122": {
      "original": "...天气很冷",
      "target": "……冰冰凉凉的。",
      "file": "script.rpy",
      "line": 18510
    },
    "5295": {
      "original": "你暂时别打扰演讲者",
      "target": "你暂时不碰这台音箱。",
      "file": "script.rpy",
      "line": 19063
    },
    "5300": {
      "original": "演奏一首歌？",
      "target": "要放首歌吗？",
      "file": "script.rpy",
      "line": 19111
    },
    "5313": {
      "original": "这个地方曾经是人们心中的支柱,如今却回荡着可能从未存在过的遥远记忆。",
      "target": "这里曾牢牢占据着我的记忆，如今却只回响着遥远的过去——也许，那些过去从未存在。",
      "file": "script.rpy",
      "line": 19399
    },
    "5315": {
      "original": "他们看起来比我上次看到时更高,站在车站入口处 ",
      "target": "对方站在车站入口，似乎比上次见面时更高了。",
      "file": "script.rpy",
      "line": 19403
    },
    "5316": {
      "original": "眼睛直射我的胸口,提醒我为什么坐火车",
      "target": "那目光直刺我的胸口，让我明白，为何坐火车来时，",
      "file": "script.rpy",
      "line": 19405
    },
    "5317": {
      "original": "我越接近现在的位置,我的脖子就越紧。",
      "target": "越接近这里，我的喉咙就绷得越紧。",
      "file": "script.rpy",
      "line": 19406
    },
    "5318": {
      "original": "然而,当我走向他们时,他们却微笑着,同样的微笑,他们不再有任何道路可走,而是向前走。",
      "target": "可当我走向对方，那张脸上仍是熟悉的笑容。我已无路可走，只能向前。",
      "file": "script.rpy",
      "line": 19407
    },
    "5325": {
      "original": "由于您尚未完成拆包,因此仍然感觉非常空旷。",
      "target": "行李还没收拾完，房间仍显得空空荡荡。",
      "file": "script.rpy",
      "line": 19434
    },
    "5339": {
      "original": "每次抽奖都标有郊区。。",
      "target": "每个抽屉，都标着一个郊区的名字……",
      "file": "script.rpy",
      "line": 19483
    },
    "5340": {
      "original": "你觉得如果你试图挖掘这些,你就会遇到麻烦",
      "target": "你觉得，乱翻这些东西大概会惹上麻烦。",
      "file": "script.rpy",
      "line": 19484
    },
    "5346": {
      "original": "提案底部有一张注释",
      "target": "提案最下面，留着一条备注。",
      "file": "script.rpy",
      "line": 19500
    },
    "5353": {
      "original": "一切仍需拆开包装。",
      "target": "还有不少行李没拆。",
      "file": "script.rpy",
      "line": 19523
    },
    "5363": {
      "original": "早些时候还没有这种削减。",
      "target": "这道伤口，之前还没有。",
      "file": "script.rpy",
      "line": 19582
    },
    "5367": {
      "original": "我想我不能...熬夜...{p=2.1}{nw}",
      "target": "我好像……没法……再醒着了……{p=2.1}{nw}",
      "file": "script.rpy",
      "line": 19600
    },
    "5368": {
      "original": "{color=#ffffff}我回来了！！你醒了吗,蜜蜂？{/颜色}",
      "target": "{color=#ffffff}我回来了！！Bee，你醒了吗？{/color}",
      "file": "script.rpy",
      "line": 19610
    },
    "5375": {
      "original": "你没有新帖子",
      "target": "你没有新邮件。",
      "file": "script.rpy",
      "line": 19646
    },
    "5379": {
      "original": "回复:突袭战场",
      "target": "RE:RAID 战斗竞技场",
      "file": "script.rpy",
      "line": 19667
    },
    "5396": {
      "original": "... 超地狱？看起来很有趣...",
      "target": "……HYPERHELL？看起来挺有意思……",
      "file": "script.rpy",
      "line": 19724
    },
    "5434": {
      "original": "有一张海报宣传可用的菜单项",
      "target": "有张海报，介绍这里供应的菜品。",
      "file": "script.rpy",
      "line": 19902
    },
    "5435": {
      "original": "有一张海报宣传值班工作人员",
      "target": "有张海报，列着当班员工。",
      "file": "script.rpy",
      "line": 19908
    },
    "5438": {
      "original": "...你会被狠狠地瞪一眼",
      "target": "……对方狠狠瞪了你一眼。",
      "file": "script.rpy",
      "line": 19921
    },
    "5439": {
      "original": "最好就让他们自己去吧……",
      "target": "还是别打扰了……",
      "file": "script.rpy",
      "line": 19923
    },
    "5441": {
      "original": "...看起来这张桌子已经很忙了",
      "target": "……这一桌的人，看起来已经忙不过来了。",
      "file": "script.rpy",
      "line": 19930
    },
    "5451": {
      "original": "你感受到了被山羊的光辉",
      "target": "你感觉自己简直是个传奇。",
      "file": "script.rpy",
      "line": 19970
    },
    "5454": {
      "original": "你打败了所有的战斗...",
      "target": "你赢下了所有战斗……",
      "file": "script.rpy",
      "line": 19978
    },
    "5456": {
      "original": "100号房间什么的",
      "target": "一百零几号房间",
      "file": "script.rpy",
      "line": 19985
    },
    "5457": {
      "original": "100号房间及类似设施,另加2个",
      "target": "一百零几号房间，再加 2",
      "file": "script.rpy",
      "line": 19991
    },
    "5458": {
      "original": "100号房间及类似设施,另加5",
      "target": "一百零几号房间，再加 5",
      "file": "script.rpy",
      "line": 19997
    },
    "5459": {
      "original": "100号房间及类似设施,另加3",
      "target": "一百零几号房间，再加 3",
      "file": "script.rpy",
      "line": 20003
    },
    "5460": {
      "original": "100号房间及类似设施,另加4",
      "target": "一百零几号房间，再加 4",
      "file": "script.rpy",
      "line": 20009
    },
    "5463": {
      "original": "现在进去就死你了",
      "target": "现在进去，简直是找死。",
      "file": "script.rpy",
      "line": 20022
    },
    "5466": {
      "original": "你看到电源切换到整个学校",
      "target": "你看见控制整座学校电源的开关。",
      "file": "script.rpy",
      "line": 20036
    },
    "5467": {
      "original": "为什么事情就这样暴露了..？",
      "target": "这种东西，怎么能就这样露在外面……？",
      "file": "script.rpy",
      "line": 20037
    },
    "5476": {
      "original": "你们都没有锁镐了……",
      "target": "你连开锁工具都没有……",
      "file": "script.rpy",
      "line": 20071
    },
    "5479": {
      "original": "这是没有错误的",
      "target": "没错，肯定是。",
      "file": "script.rpy",
      "line": 20079
    },
    "5481": {
      "original": "呆在底层就像,现在就在里面",
      "target": "现在待在底层，可是最时髦的事。",
      "file": "script.rpy",
      "line": 20086
    },
    "5490": {
      "original": "以任何一台机器的名字命名自己,你可能会变得像它们一样！！",
      "target": "把名字改成任意一台机器的名字，也许你就能变成它们的样子！！",
      "file": "script.rpy",
      "line": 20140
    },
    "5494": {
      "original": "与我们的 6 台机器战斗... 如果你击败了他们所有人,你就会获得特别奖！",
      "target": "挑战我们的 6 台机器……全部击败，就能获得特别奖励！",
      "file": "script.rpy",
      "line": 20150
    },
    "5498": {
      "original": "此外,失败不会受到处罚！输掉一场战斗？再试一次！",
      "target": "另外，失败也没有惩罚！打输了？再试一次就好！",
      "file": "script.rpy",
      "line": 20154
    },
    "5499": {
      "original": "祝你好运！接近机器以开始战斗！",
      "target": "祝你好运！靠近机器，就能开始战斗！",
