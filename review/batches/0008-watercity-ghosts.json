      "file": "script.rpy",
      "line": 26854
    },
    "7564": {
      "original": "我在这里守护着这座城市的内心深处。",
      "target": "我负责守着这座城市深处的入口。",
      "file": "script.rpy",
      "line": 26893
    },
    "7568": {
