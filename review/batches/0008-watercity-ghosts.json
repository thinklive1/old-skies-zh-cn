      "line": 27409
    },
    "7789": {
      "original": "哦？互通是这种新的..呃..技术吗？游客用那些杆子搭建的东西。",
      "target": "哦，‘互通网’就是那种新……呃……技术。游客用那些杆子搭起来的。",
      "file": "script.rpy",
      "line": 27410
    },
    "7797": {
      "original": "你给他们外卖餐",
      "target": "你把打包的饭菜递过去。",
      "file": "script.rpy",
      "line": 27431
    },
    "7807": {
      "original": "一旦你得到一些就再回来！！我想这家餐厅的名字是... 新爆发？",
      "target": "拿到饭菜，就回来！！那家餐厅，好像叫……NEW BURST？",
      "file": "script.rpy",
      "line": 27449
    },
    "7811": {
      "original": "我听说这家餐厅是根据你来自的一家餐厅改编的……",
      "target": "听说我们这家餐厅，是照着你们那边的一家餐厅建的……",
      "file": "script.rpy",
      "line": 27455
    },
    "7812": {
      "original": "... 你认为... 你能给我拿点表面餐吗？那家餐厅有什么东西吗？",
      "target": "……你觉得，能帮我带一份地表的饭菜吗？就那家餐厅的？",
      "file": "script.rpy",
      "line": 27456
    },
    "7813": {
      "original": "我很想研究它以便制作我们自己的食物！！",
      "target": "我想好好研究一下，做出我们自己的菜！！",
      "file": "script.rpy",
      "line": 27457
    },
    "7825": {
      "original": "这是该市最后一个完全未受破坏的地区",
      "target": "这是城里最后一片，还完全没被开发的地方。",
      "file": "script.rpy",
      "line": 27485
    },
    "7833": {
      "original": "当你有机会时,你注意检查一些垃圾桶",
      "target": "等有空，你决定去几个垃圾桶找找。",
      "file": "script.rpy",
      "line": 27494
    },
    "7847": {
      "original": "这是深渊区域的入口。。",
      "target": "这里是通往深渊的入口……",
      "file": "script.rpy",
      "line": 27538
    },
    "7854": {
      "original": "又嗨了！",
      "target": "嘿，又见面啦！",
      "file": "script.rpy",
      "line": 27555
    },
    "7858": {
      "original": "没办法！你也捕获了我们储存的所有鱼吗？？恭喜！",
      "target": "不会吧！这里所有种类的鱼，你也都钓到了？？恭喜！",
      "file": "script.rpy",
      "line": 27560
    },
    "7869": {
      "original": "它来自深海,用作那里的出入口……但我们为这个钓鱼点带了一些！！",
      "target": "它来自深海，我们用它进出深处……这里也运来了一些，做成了钓鱼池！！",
      "file": "script.rpy",
      "line": 27579
    },
    "7904": {
      "original": "他们甚至不和你进行眼神交流。忙着写笔。",
      "target": "对方连看都顾不上看你一眼，光忙着摆弄那支笔。",
      "file": "script.rpy",
      "line": 27655
    },
    "7911": {
      "original": "他们四处走动了一会儿",
      "target": "对方在附近翻找了一会儿。",
      "file": "script.rpy",
      "line": 27665
    },
    "7913": {
      "original": "我呃,一秒钟以为我失去了它！！",
      "target": "我，呃，刚才还以为弄丢了呢！！",
      "file": "script.rpy",
      "line": 27672
    },
    "7916": {
      "original": "你让他们去翻笔",
      "target": "你没有打扰，让对方继续欣赏那支笔。",
      "file": "script.rpy",
      "line": 27675
    },
    "7922": {
      "original": "你为什么随身带着...锅？？",
      "target": "你怎么还随身带着……花盆？？",
      "file": "script.rpy",
      "line": 27691
    },
    "7944": {
      "original": "我真的非常非常想要我自己的“笔”——这是你们用来储存墨水的东西吗？？",
      "target": "我真的特别想有一支自己的‘笔’——就是你们用来装墨水的东西，对吧？？",
      "file": "script.rpy",
      "line": 27723
    },
    "7948": {
      "original": "如果你给我一块水晶碎片,我可以用这块水晶碎片交换你吗？",
      "target": "给我找一支，我就拿这块水晶碎片跟你换，好吗？",
      "file": "script.rpy",
      "line": 27727
    },
    "7953": {
      "original": "你可能会找到一支笔,让人们经常写字。",
      "target": "呃，得经常写字的地方，应该就能找到笔……",
      "file": "script.rpy",
      "line": 27733
    },
    "7956": {
      "original": "这样就像城市的娱乐业一样",
      "target": "这边算是城市的娱乐区。",
      "file": "script.rpy",
      "line": 27746
    },
    "7969": {
      "original": "但是请与我们任何一位工作人员坐下来享受吧！",
      "target": "不过，可以坐下来，和我们的工作人员聊聊！",
      "file": "script.rpy",
      "line": 27775
    },
    "7970": {
      "original": "你可以从我身后进入这里。请注意,您订购的任何食物在您离开时都会被计费！",
      "target": "入口就在我身后。请注意，点的东西离开时要结账哦！",
      "file": "script.rpy",
      "line": 27776
    },
    "7975": {
      "original": "我不再给你这些碎片了,但我很乐意多谈谈！！",
      "target": "碎片已经没有了，可我还是很愿意继续聊！！",
      "file": "script.rpy",
      "line": 27790
    },
    "7981": {
      "original": "..你半不情愿地坐在他们旁边……",
      "target": "你有些不情愿，还是在对方身旁坐下。",
      "file": "script.rpy",
      "line": 27804
    },
    "7998": {
      "original": "嗯...显然你的眼睛更多地注视着我的水晶而不是我……",
      "target": "嗯……看来，你盯着水晶，比看着我还多……",
      "file": "script.rpy",
      "line": 27841
    },
    "7999": {
      "original": "这怎么样...如果我喜欢你,我就给你！",
      "target": "这样吧……聊得开心的话，我就把它送你！",
      "file": "script.rpy",
      "line": 27842
    },
    "8000": {
      "original": "和我聊一会儿,你为什么不呢！",
      "target": "陪我聊一会儿嘛！",
      "file": "script.rpy",
      "line": 27843
    },
    "8003": {
      "original": "他们有时会漂流上岸。我不知道从哪里来。",
      "target": "有时会被冲到岸上，可我不知道它们从哪儿来。",
      "file": "script.rpy",
      "line": 27859
    },
    "8008": {
      "original": "我不知道他们是否高兴",
      "target": "不知道，它们过得开不开心。",
      "file": "script.rpy",
      "line": 27866
    },
    "8010": {
      "original": "我认为他们还没有准备好。。",
      "target": "我觉得，还没到收获的时候……",
      "file": "script.rpy",
      "line": 27878
    },
    "8011": {
      "original": "不过我可以看到几颗豆芽",
      "target": "不过，已经能看到几个嫩芽了。",
      "file": "script.rpy",
      "line": 27879
    },
    "8015": {
      "original": "答应他们准备好后与我分享一个,好吗？",
      "target": "等熟了，记得分我一点，好吗？",
      "file": "script.rpy",
      "line": 27885
    },
    "8021": {
      "original": "... 不管怎样我都会去花园",
      "target": "……不管怎样，我还是会照料花园。",
      "file": "script.rpy",
      "line": 27913
    },
    "8033": {
      "original": "他们太高了.. 我想知道顶部是什么...",
      "target": "楼真高……不知道最上面有什么……",
      "file": "script.rpy",
      "line": 27949
    },
    "8036": {
      "original": "你……感觉你曾经有过,但似乎记不起",
      "target": "你……觉得自己去过，却怎么也想不起来。",
      "file": "script.rpy",
      "line": 27953
    },
    "8037": {
      "original": "也许有一天我们可以一起参观山顶？",
      "target": "也许有一天，我们能一起上去看看？",
      "file": "script.rpy",
      "line": 27954
    },
    "8041": {
      "original": "...你有一种感觉,事情并不总是这样,但没有心告诉她。",
      "target": "……你觉得，那里原本并非如此，却不忍心告诉她。",
      "file": "script.rpy",
      "line": 27959
    },
    "8056": {
      "original": "我以为太阳应该喜欢--这样做-- ",
      "target": "太阳不应该——就是——会落下的吗——",
      "file": "script.rpy",
      "line": 27999
    },
    "8075": {
      "original": "他们都是巨人！！",
      "target": "两栋都好高！！",
      "file": "script.rpy",
      "line": 28057
    },
    "8077": {
      "original": "... 我不认为...",
      "target": "……我好像……",
      "file": "script.rpy",
      "line": 28060
    },
    "8078": {
      "original": "我见过鱼吗？",
      "target": "从来没见过鱼？",
      "file": "script.rpy",
      "line": 28061
    },
    "8084": {
      "original": "它更加清晰、更加漂亮。",
      "target": "那片蓝，更清澈，也更漂亮……",
      "file": "script.rpy",
      "line": 28079
    },
    "8115": {
      "original": "我现在肯定被晒伤了！",
      "target": "不然，我现在肯定已经晒伤了！",
      "file": "script.rpy",
      "line": 28158
    },
    "8120": {
      "original": "我想...我会把草...砍下来一点...很快的某个时候...",
      "target": "我想……过一阵子……该去修修草了……",
      "file": "script.rpy",
      "line": 28174
    },
    "8142": {
      "original": "但是..周围没有吗？我想我只看到一个人深入城市。。",
      "target": "可周围……根本没什么车？我只见过一辆，开进了城里……",
      "file": "script.rpy",
      "line": 28231
    },
    "8163": {
      "original": "不过,我还是把垃圾箱挖了一点。。",
      "target": "不过，我还是翻了翻垃圾桶……",
      "file": "script.rpy",
      "line": 28278
    },
    "8177": {
      "original": "所以也许我们第二天会再次见面！！",
      "target": "那就后天，再见面吧！！",
      "file": "script.rpy",
      "line": 28305
    },
    "8184": {
      "original": "出色地.. 他就在附近,你知道吗？",
      "target": "这个嘛……至少，他就在旁边，你懂的。",
      "file": "script.rpy",
      "line": 28323
    },
    "8214": {
      "original": "我以前从未见过这么多人这样在一起",
      "target": "我从没见过这么多树，长在一起。",
      "file": "script.rpy",
      "line": 28390
    },
    "8218": {
      "original": "它很像房子,所以我必须",
      "target": "看着像个家，那应该就是吧。",
      "file": "script.rpy",
      "line": 28404
    },
    "8235": {
      "original": "那些巨大的石墙可以防止人们摔倒",
      "target": "那些高大的石墙，能防止人摔下去。",
      "file": "script.rpy",
      "line": 28446
    },
    "8237": {
      "original": "哪一个..奇怪-我有脚吗？",
      "target": "这就……奇怪了——我有脚吗？",
      "file": "script.rpy",
      "line": 28448
    },
    "8252": {
      "original": "努普... 没有一条该死的鱼",
      "target": "没有……一条鱼都没钓到。",
      "file": "script.rpy",
      "line": 28487
    },
    "8253": {
      "original": "...他们会咬人。最终。",
      "target": "……总会咬钩的。迟早。",
      "file": "script.rpy",
      "line": 28488
    },
    "8268": {
      "original": "它的满足",
      "target": "很有成就感。",
      "file": "script.rpy",
      "line": 28526
    },
    "8276": {
      "original": "这是一个很好的节奏变化",
      "target": "换换环境，挺好的。",
      "file": "script.rpy",
      "line": 28546
    },
    "8293": {
      "original": "这个补丁确实是空的。。 ",
      "target": "这块地方，真空旷……",
      "file": "script.rpy",
      "line": 28587
    },
    "8301": {
      "original": "我不知道他们什么时候会用完",
      "target": "不知道，这些水什么时候才会用完。",
      "file": "script.rpy",
      "line": 28597
    },
    "8312": {
      "original": "他们在这里高高耸立在我们之上",
      "target": "它们高高耸立，把我们都压在下面。",
      "file": "script.rpy",
      "line": 28630
    },
    "8313": {
      "original": "总是隐约可见...",
      "target": "总是笼罩在头顶……",
      "file": "script.rpy",
      "line": 28631
    },
    "8317": {
      "original": "我想知道水是否可以游过去",
      "target": "不知道，这里的水还能不能游泳。",
      "file": "script.rpy",
      "line": 28637
    },
    "8334": {
      "original": "但我们所有的机器仍然工作！！请随意尝试一下！！",
      "target": "不过，机器都还能用！！尽管去试试！！",
      "file": "script.rpy",
      "line": 28677
    },
    "8340": {
      "original": "你可以玩游戏... 并玩游戏。。 还有呃... 还有泳池！",
      "target": "你可以玩游戏……继续玩游戏……还有，呃……台球！",
      "file": "script.rpy",
      "line": 28694
    },
    "8350": {
      "original": "不可能！！太恶心了！",
      "target": "不会吧！！太酷了！",
      "file": "script.rpy",
      "line": 28721
    },
    "8379": {
      "original": "也许是你使用的机器...你试过我的幸运机器吗？？",
      "target": "也许是机器的问题……试过我那台幸运机器了吗？？",
      "file": "script.rpy",
      "line": 28776
    },
    "8380": {
      "original": "回到它！！",
      "target": "再去试试！！",
      "file": "script.rpy",
      "line": 28777
    },
    "8394": {
      "original": "每个人似乎都会以他们认为被使用的方式重新填充它们",
      "target": "大家按照自己想象中的用途，重新把它们利用起来。",
      "file": "script.rpy",
      "line": 28811
    },
    "8395": {
      "original": "就像商店一样——那里的人实际上并没有受雇于任何人…… 他只是这么做",
      "target": "就像那家店——里面的人，根本没被谁雇来……他只是自愿在做。",
      "file": "script.rpy",
      "line": 28812
    },
    "8400": {
      "original": "... 我确信有些地方已经开放了求职申请,如果没有的话。",
      "target": "……如果没有，我想有些地方正在招人。",
      "file": "script.rpy",
      "line": 28818
    },
    "8401": {
      "original": "这条小盟友之路非常好",
      "target": "这条小巷，挺不错。",
      "file": "script.rpy",
      "line": 28820
    },
    "8402": {
      "original": "这是恰到好处的私人水平。没有人来这里,但我并没有打扰你。",
      "target": "够清静，没人会来，我也没打扰到谁。",
      "file": "script.rpy",
      "line": 28821
    },
    "8404": {
      "original": "你去过路边的拱廊吗？",
      "target": "去过路边那家游戏厅吗？",
      "file": "script.rpy",
      "line": 28833
    },
    "8405": {
      "original": "太恶心了！我不知道他们是如何让这些旧机器运转起来的。",
      "target": "真够酷的！不知道他们怎么让那些老机器重新运转起来的……",
      "file": "script.rpy",
      "line": 28834
    },
    "8409": {
      "original": "我利用我找到的这枚硬币来获得平均值…… 哥们！",
      "target": "我拿捡到的硬币，去换了顿饭……老天！",
      "file": "script.rpy",
      "line": 28839
    },
    "8427": {
      "original": "所以我们只是要扔掉我发现的所有这些东西！！疯狂起来！",
      "target": "所以，找到的这些衣服全都白送！！随便挑吧！",
      "file": "script.rpy",
      "line": 28894
    },
    "8430": {
      "original": "提醒一下,所有可以抢的东西——随便拿吧！",
      "target": "提醒一下，这里的东西都可以拿——喜欢什么就拿什么！",
      "file": "script.rpy",
      "line": 28898
    },
    "8434": {
      "original": "噢！你换衣服了吗？太热了！！",
      "target": "哦！你换衣服了？真性感！！",
      "file": "script.rpy",
      "line": 28921
    },
    "8460": {
      "original": "谢谢你来给我看！我也很照顾这个数字！",
      "target": "谢谢你特意穿来给我看！那个手办，我也保管得很好哦！",
      "file": "script.rpy",
      "line": 28986
    },
    "8463": {
      "original": "我把这个数字放在了安全的地方！它将被永远珍藏！！再次感谢您抓住它！",
      "target": "我把手办放在安全的地方了，一定会永远珍藏！！再谢你一次！",
      "file": "script.rpy",
      "line": 29001
    },
    "8477": {
      "original": "你很确定你在附近的商店里看到了这个身影。。",
      "target": "你很确定，附近的店里有那个手办……",
      "file": "script.rpy",
      "line": 29030
    },
    "8478": {
      "original": "如果你设法抓住一个,请立即告诉我！！！",
      "target": "找到了，就快回来告诉我！！！",
      "file": "script.rpy",
      "line": 29031
    },
    "8486": {
      "original": "这是他们很久以前制作的她穿着这套衣服的身影。",
      "target": "他们很久以前，还做过一个她穿这套衣服的手办。",
      "file": "script.rpy",
      "line": 29043
    },
    "8489": {
      "original": "嘿--告诉你吧。如果你能帮我找到那个身影,我就用这件礼服换你！你穿起来会很好看！",
      "target": "这样吧，帮我找到那个手办，我就把这件礼服给你！你穿一定好看！",
      "file": "script.rpy",
      "line": 29047
    },
    "8491": {
      "original": "你同意去找那个人物。。",
      "target": "你答应去找那个手办……",
      "file": "script.rpy",
      "line": 29049
    }
  },
