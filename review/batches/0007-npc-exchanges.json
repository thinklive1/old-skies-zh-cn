    "7316": {
      "original": "我希望那锅能陪伴你。",
      "target": "希望那个花盆，能好好陪着你。",
      "file": "script.rpy",
      "line": 26222
    },
    "7334": {
      "original": "太好了！但由于某种原因,开始不断循环。",
      "target": "挺好听的！可不知道为什么，开头一直在循环。",
      "file": "script.rpy",
      "line": 26272
    },
    "7336": {
      "original": "那一定是轻声听到的音乐",
      "target": "原来，刚才隐约听见的音乐就是这个。",
      "file": "script.rpy",
      "line": 26274
    },
    "7349": {
      "original": "如果您要进入任何浴室,请记住脱掉鞋子",
      "target": "要进浴池的话，记得先脱鞋。",
      "file": "script.rpy",
      "line": 26319
    },
    "7355": {
      "original": "我需要漂浮物,好吗",
      "target": "我需要游泳圈，好吗。",
      "file": "script.rpy",
      "line": 26341
    },
    "7366": {
      "original": "我会尽量不再放弃它哈哈！",
      "target": "我会小心，别再弄丢了，哈哈！",
      "file": "script.rpy",
      "line": 26370
    },
    "7376": {
      "original": "好吧--坚持住！希望我能尽快找到自己的！",
      "target": "总之——你好好留着吧！希望我也能早点找到自己的！",
      "file": "script.rpy",
      "line": 26383
    },
    "7397": {
      "original": "你觉得你可以用一个",
      "target": "你觉得，来一杯也不错。",
      "file": "script.rpy",
      "line": 26442
    },
    "7402": {
      "original": "享受！",
      "target": "请慢用！",
      "file": "script.rpy",
      "line": 26450
    },
    "7412": {
      "original": "当我偷偷咬掉他们的盘子时,人们会对我生气",
      "target": "我偷偷吃顾客盘里的东西，他们居然会生气！",
      "file": "script.rpy",
      "line": 26480
    },
    "7426": {
      "original": "你跟我说话怎么样？？？？",
      "target": "你怎么还能跟我说话？？？？",
      "file": "script.rpy",
      "line": 26526
    },
    "7435": {
      "original": "哦我？我上不去",
      "target": "哦，我？我不坐车。",
      "file": "script.rpy",
      "line": 26559
    },
    "7449": {
      "original": "寒冷",
      "target": "就是放松一下。",
      "file": "script.rpy",
      "line": 26594
    },
    "7450": {
      "original": "你感觉到我了吗？",
      "target": "你懂我意思吧？",
      "file": "script.rpy",
      "line": 26595
    },
    "7454": {
      "original": "与“孤独”的典型生活方式的氛围",
      "target": "喜欢那种独来独往的生活。",
      "file": "script.rpy",
      "line": 26600
    },
    "7460": {
      "original": "你走吧",
      "target": "给你。",
      "file": "script.rpy",
      "line": 26614
    },
    "7462": {
      "original": "这是一个隐藏的,我相信百分之百的人会喜欢这个",
      "target": "而且还是隐藏成就。全成就党，肯定喜欢这个。",
      "file": "script.rpy",
      "line": 26616
    },
    "7472": {
      "original": "如果您正在办理登机手续,请核对您的姓名",
      "target": "办理入住的话，请核对一下您的姓名。",
      "file": "script.rpy",
      "line": 26636
    },
    "7476": {
      "original": "显然今天只有一台在用",
      "target": "今天好像只有一辆车在跑。",
      "file": "script.rpy",
      "line": 26648
    },
    "7494": {
      "original": "我认为他们不是为了这座建筑？他们身上有屋顶这个词",
      "target": "好像不是这栋楼的钥匙？上面写着‘屋顶’。",
      "file": "script.rpy",
      "line": 26702
    },
    "7496": {
      "original": "我不需要这些,所以你可以拥有它们",
      "target": "我用不上，给你吧。",
      "file": "script.rpy",
      "line": 26704
    }
  },
