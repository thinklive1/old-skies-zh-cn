      "target": "标签上写着‘墨盒’。",
      "file": "script.rpy",
      "line": 23456
    },
    "6415": {
      "original": "上图:休息室+厨房",
      "target": "向上：休息室+厨房",
      "file": "script.rpy",
      "line": 23475
    },
    "6418": {
      "original": "它对...漫画开放！？",
      "target": "翻开的那页是……漫画！？",
      "file": "script.rpy",
      "line": 23483
    },
    "6420": {
      "original": "它对一些复杂的写作持开放态度",
      "target": "翻开的那页，写着复杂的文字。",
      "file": "script.rpy",
      "line": 23490
    },
    "6432": {
      "original": "也不是免费的,请不要服用该植物",
      "target": "也不免费，请不要拿走这株植物。",
      "file": "script.rpy",
      "line": 23527
    },
    "6447": {
