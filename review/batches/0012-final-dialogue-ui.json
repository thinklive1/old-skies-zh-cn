{
  "name": "0012-final-dialogue-ui",
  "changes": {
    "11000": {
      "original": "奇数液体下方的地板呈圆形。",
      "target": "奇怪的液体下，地板上有一个圆形轮廓。",
      "file": "script.rpy",
      "line": 36876
    },
    "11001": {
      "original": "你发现脚踏板上有一个洞,似乎适合你的水晶。。",
      "target": "你看见一个基座，上面的孔似乎正好能放入水晶……",
      "file": "script.rpy",
      "line": 36877
    },
    "11002": {
      "original": "你决定将水晶插入脚踏板……",
      "target": "你决定把水晶嵌进基座……",
      "file": "script.rpy",
      "line": 36878
    },
    "11003": {
      "original": ".... 地板上的形状向后滑动,露出一个洞。",
      "target": "……圆形地板向后滑开，露出一个洞口。",
      "file": "script.rpy",
      "line": 36879
    },
    "11017": {
      "original": "你深入液体",
      "target": "你潜进更深的液体中。",
      "file": "script.rpy",
      "line": 36930
    },
    "11021": {
      "original": "深入研究一下可能没问题……",
      "target": "潜下去，应该没问题……",
      "file": "script.rpy",
      "line": 36944
    },
    "11099": {
      "original": "你跳进洞里",
      "target": "你潜进了洞口。",
      "file": "script.rpy",
      "line": 37327
    },
    "11222": {
      "original": "...今天是星期天。你猜你明天应该回来。。",
      "target": "……今天是星期天。看来，只能明天再来了……",
      "file": "script.rpy",
      "line": 37854
    },
    "11233": {
      "original": "你以为门已经生锈了,但它似乎已经打开了。。",
      "target": "你还以为这扇门锈住了，可现在似乎打开了……",
      "file": "script.rpy",
      "line": 37928
    },
    "11234": {
      "original": "...房子的门生锈了...",
      "target": "……房门已经锈死了……",
      "file": "script.rpy",
      "line": 37932
    },
    "11236": {
      "original": "你需要走... 家...",
      "target": "你得……回家……",
      "file": "script.rpy",
      "line": 37952
    },
    "11255": {
      "original": "你离开吧,不然住在这里的人就会回来。",
      "target": "趁屋主还没回来，你离开了。",
      "file": "script.rpy",
      "line": 38093
    },
    "11290": {
      "original": "你得分了:[num_hits]！恭喜！",
      "target": "你的得分：[num_hits]！恭喜！",
      "file": "script.rpy",
      "line": 38323
    },
    "11309": {
      "original": "您想玩一轮更高或更低的游戏吗？",
      "target": "要玩一轮比大小吗？",
      "file": "script.rpy",
      "line": 38499
    },
    "11310": {
      "original": "播放",
      "target": "开始",
      "file": "script.rpy",
      "line": 38500
    },
    "11315": {
      "original": "你滚得比经销商还低。",
      "target": "你掷出的点数，比庄家小。",
      "file": "script.rpy",
      "line": 38518
    },
    "11317": {
      "original": "你和经销商掷了相同的数字！",
      "target": "你和庄家，掷出了相同点数！",
      "file": "script.rpy",
      "line": 38523
    },
    "11319": {
      "original": "你比经销商滚得更高！",
      "target": "你掷出的点数，比庄家大！",
      "file": "script.rpy",
      "line": 38528
    },
    "11321": {
      "original": "你比经销商还低……",
      "target": "你的点数，比庄家小……",
      "file": "script.rpy",
      "line": 38533
    },
    "11326": {
      "original": "...骰子有重量吗？！",
      "target": "……骰子动了手脚？！",
      "file": "script.rpy",
      "line": 38547
    },
    "11327": {
      "original": "经销商向你眨眼",
      "target": "庄家朝你眨了眨眼。",
      "file": "script.rpy",
      "line": 38551
    },
    "11328": {
      "original": "...你会分心,需要重新滚动",
      "target": "……你分了神，只好重新掷骰。",
      "file": "script.rpy",
      "line": 38552
    },
    "11329": {
      "original": "等等...经销商看起来很熟悉...？眼罩和尖头鞋？！",
      "target": "等等……这庄家怎么有点眼熟……？眼罩，还有尖头鞋？！",
      "file": "script.rpy",
      "line": 38556
    },
    "11334": {
      "original": "你决定减少损失并辞职",
      "target": "你决定及时止损，不玩了。",
      "file": "script.rpy",
      "line": 38569
    },
    "11337": {
      "original": "你离开桌子时,口袋感觉轻松多了",
      "target": "离开赌桌时，你的口袋轻了不少。",
      "file": "script.rpy",
      "line": 38575
    },
    "11349": {
      "original": "你会看到这款游戏的内部运作尽力防止你崩溃",
      "target": "你看见，游戏内部正拼命运转，试图阻止自己崩溃。",
      "file": "script.rpy",
      "line": 38623
    },
    "11352": {
      "original": "不要在主游戏中加载 EIMI 演示中的保存！",
      "target": "别在正式游戏里，读取 EIMI 试玩版的存档！",
      "file": "script.rpy",
      "line": 38634
    },
    "11353": {
      "original": "我知道你做到了！",
      "target": "我知道，你已经这么干了！",
      "file": "script.rpy",
      "line": 38635
    },
    "11356": {
      "original": "对你的笑话",
      "target": "这下，轮到你吃瘪了。",
      "file": "script.rpy",
      "line": 38638
    },
    "11357": {
      "original": "我被激怒了",
      "target": "我可是高手。",
      "file": "script.rpy",
      "line": 38639
    },
    "11358": {
      "original": "您需要删除此保存文件。",
      "target": "你得删掉这个存档。",
      "file": "script.rpy",
      "line": 38644
    },
    "11373": {
      "original": "为您的房屋定制 SELCET",
      "target": "选择房屋装修方案",
      "file": "script.rpy",
      "line": 38701
    },
    "11374": {
      "original": "看起来你可以根据自己的喜好轻松地在这里改造你的房子",
      "target": "看起来，你可以用手头已有的东西，轻松改造房子。",
      "file": "script.rpy",
      "line": 38702
    },
    "11385": {
      "original": "此选项目前已投入使用",
      "target": "已在使用这个方案",
      "file": "script.rpy",
      "line": 38735
    },
    "11434": {
      "original": "...你家里有新东西吗？",
      "target": "……你给家里添了点新东西？",
      "file": "script.rpy",
      "line": 39093
    },
    "11435": {
      "original": "CD上有一张注释。",
      "target": "CD 上附着一条备注。",
      "file": "script.rpy",
      "line": 39094
    },
    "11436": {
      "original": "如果您看到这种情况,您可能会以某种方式使机器失去秩序！",
      "target": "看到这条备注，说明你大概没按顺序，就击败了那些机器！",
      "file": "script.rpy",
      "line": 39095
    },
    "11440": {
      "original": "保持忙碌？",
      "target": "近来还忙吗？",
      "file": "script.rpy",
      "line": 39119
    },
    "11448": {
      "original": "啊,好吧！这次也许吧？",
      "target": "好吧！也许，这一回就行了？",
      "file": "script.rpy",
      "line": 39132
    },
    "11459": {
      "original": "坚持住！！",
      "target": "拿好这个！！",
      "file": "script.rpy",
      "line": 39160
    },
    "11464": {
      "original": "你有点生锈了,不是吗？",
      "target": "有阵子没练了，是吧？",
      "file": "script.rpy",
      "line": 39168
    },
    "11474": {
      "original": "如果没有这个,你就无法超越我的学生！",
      "target": "没有这个，我的学生可不会放你过去！",
      "file": "script.rpy",
      "line": 39183
    },
    "11475": {
      "original": "他们再次闪现闪亮的硬币",
      "target": "老人又亮出那枚闪亮的硬币。",
      "file": "script.rpy",
      "line": 39184
    },
    "11481": {
      "original": "... 看来你又输了,是吗？",
      "target": "……看来，你又把自己弄丢了，嗯？",
      "file": "script.rpy",
      "line": 39192
    },
    "11485": {
      "original": "但我的学生却这么做了！！我刚才把它搬到那里保管！",
      "target": "不过，学生那儿有！！前阵子，我把它送过去保管了！",
      "file": "script.rpy",
      "line": 39197
    },
    "11486": {
      "original": "所以去问他们吧！他们会引导你去做这件事！",
      "target": "去问他们吧！他们会带你找到它！",
      "file": "script.rpy",
      "line": 39198
    },
    "11487": {
      "original": "他们正在这里北边的小建筑集合处！万一你...忘记了...",
      "target": "就在北边那几栋小房子里！省得你……忘记……",
      "file": "script.rpy",
      "line": 39199
    },
    "11490": {
      "original": "等一下！等一下！等一下！你是不是很渴望啊！",
      "target": "等等！等等！先别急！这么迫不及待啊！",
      "file": "script.rpy",
      "line": 39203
    },
    "11491": {
      "original": "我的学生不会随便给任何老无名小卒访问权限！你得先证明自己！",
      "target": "我的学生，不会随便放谁进去！你得先证明自己！",
      "file": "script.rpy",
      "line": 39204
    },
