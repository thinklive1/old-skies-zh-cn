      "line": 16264
    },
    "4432": {
      "original": "{font=cc2.ttf}BUSSTOP 这里{/font}",
      "target": "{font=cc2.ttf}公交站在此{/font}",
      "file": "script.rpy",
      "line": 16270
    },
    "4434": {
      "original": "房子周围有一棵又大又粗的树篱",
      "target": "房子周围围着一道浓密的树篱。",
      "file": "script.rpy",
      "line": 16277
    },
    "4436": {
      "original": "花园周围有一棵又大又粗的树篱",
      "target": "花园周围围着一道浓密的树篱。",
      "file": "script.rpy",
      "line": 16289
    },
    "4439": {
      "original": "与你周围的其他人不同,这个似乎是假的",
      "target": "和周围其他植物不同，这一株似乎是假的。",
      "file": "script.rpy",
      "line": 16302
    },
    "4441": {
      "original": "气味...很强烈。。",
      "target": "气味……很冲……",
      "file": "script.rpy",
      "line": 16309
    },
    "4451": {
      "original": "该标志下方的确切瓷砖是在 2027 年制作的",
      "target": "牌子正下方的那块地砖，制造于 2027 年",
      "file": "script.rpy",
      "line": 16334
    },
    "4453": {
      "original": "他们身上有小贴纸",
      "target": "箱子上贴着小标签。",
      "file": "script.rpy",
      "line": 16341
    },
    "4458": {
      "original": "成立于2067年。",
      "target": "制作于 2067 年。",
      "file": "script.rpy",
      "line": 16351
    },
    "4465": {
      "original": "有桌子吗..？上面有一块小牌匾",
      "target": "这里有张……桌子？上面嵌着一块小铭牌。",
      "file": "script.rpy",
      "line": 16373
    },
    "4468": {
      "original": "这是接待处。。 考虑到所有因素,它的状况还不错",
      "target": "这是接待台……总的来说，保存得还算不错。",
      "file": "script.rpy",
      "line": 16386
    },
    "4469": {
      "original": "这是接待处。。 你可以看到柜台后面的电脑已经完全死机了",
      "target": "这是接待台……柜台后面的电脑，显然早已坏了。",
      "file": "script.rpy",
      "line": 16392
    },
    "4470": {
      "original": "难怪这里的这个街机可以让您免费玩。。",
      "target": "难怪这家游戏厅让人免费玩……",
      "file": "script.rpy",
      "line": 16393
    },
    "4472": {
      "original": "这里有一张海报,宣传商店里的一些新街机游戏。这是一款赛车游戏",
      "target": "海报宣传着游戏厅新进的一款街机游戏，是个赛车游戏。",
      "file": "script.rpy",
      "line": 16405
    },
    "4473": {
      "original": "这里有一张海报,宣传一些东西？由于植物生长在上面,所以很难看清",
      "target": "海报在宣传什么……？被植物盖住了，看不太清。",
      "file": "script.rpy",
      "line": 16411
    },
    "4478": {
      "original": "这里有一个垃圾箱...你不想在其中挖洞。",
      "target": "这里有个垃圾桶……你不想伸手进去翻。",
      "file": "script.rpy",
      "line": 16441
    },
    "4482": {
      "original": "你想知道他们是否曾经出来过",
      "target": "你不知道，那些游戏后来到底有没有上市。",
      "file": "script.rpy",
      "line": 16455
    },
    "4486": {
      "original": "你怀疑有人在这里呆了很长时间",
      "target": "你觉得，这里已经很久没人来了。",
      "file": "script.rpy",
      "line": 16469
    },
    "4497": {
      "original": "它有一颗蓝色的宝石……它从到达它的那一丝光线中闪闪发光",
      "target": "项链上嵌着一颗蓝宝石，在仅有的一丝光线里微微闪烁。",
      "file": "script.rpy",
      "line": 16509
    },
    "4498": {
      "original": "..它太漂亮了,不能坐在这里。。",
      "target": "……这么漂亮，实在不该被遗留在这里……",
      "file": "script.rpy",
      "line": 16510
    }
