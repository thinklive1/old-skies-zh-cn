    "9033": {
      "original": "你把东西放在这里各处！找到他们！！",
      "target": "你把东西留在四处了！去找出来！！",
      "file": "script.rpy",
      "line": 30187
    },
    "9105": {
      "original": "但是--我有一条消息要告诉你。来自你自己,同样如此！",
      "target": "不过——我得给你传句话。还是你自己留下的呢！",
      "file": "script.rpy",
      "line": 30302
    },
    "9117": {
      "original": "啊哈！我们是谁在开玩笑！！",
      "target": "啊哈！我们骗谁呢！！",
      "file": "script.rpy",
      "line": 30336
    },
    "9130": {
      "original": "显然只有那些接近主人的人才是",
      "target": "听说，只有师父亲近的人才准进去。",
      "file": "script.rpy",
      "line": 30363
    },
    "9132": {
      "original": "T-内部房间可从通道左侧的下方进入。",
      "target": "内、内室可以从左侧通道下面进去。",
      "file": "script.rpy",
      "line": 30375
    },
    "9135": {
      "original": "W-欢迎回来！！你和师父谈过吗？",
      "target": "欢、欢迎回来！！见过师父了吗？",
      "file": "script.rpy",
      "line": 30383
    },
    "9138": {
      "original": "你、你打败了主人吗？",
      "target": "你、你打败师父了？",
      "file": "script.rpy",
      "line": 30387
    },
    "9145": {
      "original": "W-欢迎！！这是学徒区神社！！",
      "target": "欢、欢迎！！这里是学徒神社！！",
      "file": "script.rpy",
      "line": 30403
    },
    "9146": {
      "original": "如果你还没有见过我们的主人,他就在我们南边的神社里！！",
      "target": "没见过师父的话，他就在南边的神社里！！",
      "file": "script.rpy",
      "line": 30404
    },
    "9159": {
      "original": "我和他最好的是——",
      "target": "最棒的是，我和他——",
      "file": "script.rpy",
      "line": 30436
    },
    "9161": {
      "original": "我们一起住在这里！！这就像一场永无止境的过夜！",
      "target": "我们一起住在这里！！就像永远不会结束的留宿派对！",
      "file": "script.rpy",
      "line": 30438
    },
    "9169": {
      "original": "他的动作并不真正参与其中,而且他总是提前完成",
      "target": "他不怎么肯认真跳，动作也老是提前。",
      "file": "script.rpy",
      "line": 30448
    },
    "9175": {
      "original": "我以为北方应该是和平的。。",
      "target": "我还以为，北边会比较清静……",
      "file": "script.rpy",
      "line": 30465
    },
    "9189": {
      "original": "... 啊！！你全都明白了！",
      "target": "……啊！！你全找到了！",
      "file": "script.rpy",
      "line": 30496
    },
    "9194": {
      "original": "那么,再见！有空回来吧,我会给你一个生长物的样本！！",
      "target": "有空再来，等长好了，让你尝尝！！",
      "file": "script.rpy",
      "line": 30508
    },
    "9198": {
      "original": "对不起,姑娘,你走吧！！",
      "target": "抱歉，姑娘，给你！！",
      "file": "script.rpy",
      "line": 30513
    },
    "9204": {
      "original": "...... 但不能吗？？？我仍然需要那个喷壶,你知道吗！！",
      "target": "……可没洒水壶？？？洒水壶也得有啊！！",
      "file": "script.rpy",
      "line": 30532
    },
    "9206": {
      "original": "艾达知道什么,是吗？我想我们得去别处看看！！",
      "target": "哎呀，这可怎么办？看来得去别处找找！！",
      "file": "script.rpy",
      "line": 30534
    },
    "9207": {
      "original": "我确信你能帮我找到一个！！一旦你回来,你就回来吧！！",
      "target": "你肯定能找到！！找到了，就回来！！",
      "file": "script.rpy",
      "line": 30535
    },
    "9233": {
      "original": "你错过的所有东西都应该在你得到这些种子的商店里！",
      "target": "缺的东西，应该都在你拿种子的那家店里！",
      "file": "script.rpy",
      "line": 30580
    },
    "9235": {
      "original": ".....好吧,肥料应该还在那里,但我不知道那可以！",
      "target": "……肥料应该还在，可洒水壶在哪儿，我就不知道了！",
      "file": "script.rpy",
      "line": 30583
    },
    "9237": {
      "original": "开始吧！我在等你！！",
      "target": "快去吧！我等着！！",
      "file": "script.rpy",
      "line": 30585
    },
    "9251": {
      "original": "你错过的所有东西都应该在你买肥料的商店里！",
      "target": "缺的东西，应该都在你拿肥料的那家店里！",
      "file": "script.rpy",
      "line": 30614
    },
    "9253": {
      "original": ".....好吧,你的种子应该还在那里,但我不知道那可以！",
      "target": "……种子应该还在，可洒水壶在哪儿，我就不知道了！",
      "file": "script.rpy",
      "line": 30617
    },
    "9257": {
      "original": "你成功抓住了我吗？",
      "target": "需要的东西，你都帮我拿来了？",
      "file": "script.rpy",
      "line": 30626
    },
    "9266": {
      "original": "哦,如果能加个水罐就好了,我现在的罐子都生锈了……",
      "target": "还有洒水壶也得换一个，现在这个已经锈得不成样了……",
      "file": "script.rpy",
      "line": 30641
    },
    "9269": {
      "original": "我会-呃-补偿你！补偿？公司",
      "target": "我会——呃——报酬你！报……报答？报——",
      "file": "script.rpy",
      "line": 30644
    },
    "9270": {
      "original": "你用“补偿”来纠正它们",
      "target": "你提醒对方，应该说‘给你报酬’。",
      "file": "script.rpy",
      "line": 30645
    },
    "9274": {
      "original": "上次我跳过去时,它们已经跑得很低了,但这是最好的选择！！一切也是免费的！",
      "target": "上次去的时候，东西已经剩不多了，可那里还是最有希望！！而且全免费！",
      "file": "script.rpy",
      "line": 30650
    },
    "9283": {
      "original": "如果我没记错的话...那是神社旁边的白宫。。",
      "target": "没记错的话……是神社旁边那栋白色的房子。",
      "file": "script.rpy",
      "line": 30675
    },
    "9314": {
      "original": "对我有用！！",
      "target": "我倒是乐意！！",
      "file": "script.rpy",
      "line": 30735
    },
    "9330": {
      "original": "D-你现在想交易吗？",
      "target": "要、要现在交换吗？",
      "file": "script.rpy",
      "line": 30785
    },
    "9344": {
      "original": "D-你想交易吗？",
      "target": "要、要交换吗？",
      "file": "script.rpy",
      "line": 30806
    },
    "9356": {
      "original": "H-你找到那条丝带了吗？",
      "target": "你、你找到那条丝带了吗？",
      "file": "script.rpy",
      "line": 30826
    },
    "9358": {
      "original": "在你找到它之前不要交易！！",
      "target": "没找到丝带，就不换！！",
      "file": "script.rpy",
      "line": 30829
    },
    "9365": {
      "original": "你问她是否愿意给你浇水罐--",
      "target": "你问她，愿不愿意把洒水壶给你——",
      "file": "script.rpy",
      "line": 30841
    },
    "9369": {
      "original": "我--如果你有一条丝带我可以拥有的话,我可能会交易你……？",
      "target": "我——如果你能给我一条丝带，也许可以换……？",
      "file": "script.rpy",
      "line": 30846
    },
    "9371": {
      "original": "如果你明白了,我们可以交换！！",
      "target": "拿到了，我们就交换！！",
      "file": "script.rpy",
      "line": 30848
    },
    "9401": {
      "original": "时间又临近了,然后",
      "target": "看来，又快到那个时候了。",
      "file": "script.rpy",
      "line": 30922
    },
    "9405": {
      "original": "在这里,为你",
      "target": "给你。",
      "file": "script.rpy",
      "line": 30928
    },
    "9409": {
      "original": "你会再次弄清楚",
      "target": "你会再次想明白的。",
      "file": "script.rpy",
      "line": 30933
    },
    "9417": {
      "original": "...我...在这里很蔑视",
      "target": "……我……在这里，还算知足。",
      "file": "script.rpy",
      "line": 30954
    },
    "9481": {
      "original": "...你看着植物占据座位的另一半,它会让你怒目而视",
      "target": "……你望向占着另一半座位的植物。它狠狠瞪了你一眼。",
      "file": "script.rpy",
      "line": 31085
    },
    "9483": {
      "original": "...至少对于第一个... 我从来没有克服过这一点！",
      "target": "……至少，第一层要这样……我从来没走过更远！",
      "file": "script.rpy",
      "line": 31087
    }
  },
