{
  "name": "0011-club-return-home",
  "changes": {
    "10250": {
      "original": "你能告诉我一些关于表面的事情吗？",
      "target": "能跟我讲讲地表的事吗？",
      "file": "script.rpy",
      "line": 33400
    },
    "10254": {
      "original": "你告诉他们水面不在水下",
      "target": "你告诉对方，地表不在水底下。",
      "file": "script.rpy",
      "line": 33406
    },
    "10256": {
      "original": ".. 这就是为什么它是表面？？",
      "target": "……所以，才叫地表？？",
      "file": "script.rpy",
      "line": 33411
    },
    "10258": {
      "original": "这真的是你拥有的最好的东西吗...",
      "target": "你能想到的，就只有这个吗……",
      "file": "script.rpy",
      "line": 33413
    },
    "10260": {
      "original": "你提到了表面上所有不同的食物和餐馆",
      "target": "你说起地表各式各样的食物与餐厅。",
      "file": "script.rpy",
      "line": 33418
    },
    "10274": {
      "original": "低音",
      "target": "鲈鱼",
      "file": "script.rpy",
      "line": 33448
    },
    "10290": {
      "original": "我是{font=cc2.ttf}记住{/font}！",
      "target": "我是{font=cc2.ttf}remember{/font}！",
      "file": "script.rpy",
      "line": 33487
    },
    "10295": {
      "original": "我就叫你假人什么的吧。。",
      "target": "那我就叫你‘笨蛋’好了……",
      "file": "script.rpy",
      "line": 33498
    },
    "10329": {
      "original": "解决了这个问题...",
      "target": "好了，名字说完了……",
      "file": "script.rpy",
      "line": 33582
    },
    "10335": {
      "original": "是的,好吧。有点无意义的答案...",
      "target": "好吧，可这答案也太没意思了……",
      "file": "script.rpy",
      "line": 33593
    },
    "10337": {
      "original": "我个人是粉红色的粉丝",
      "target": "我自己最喜欢粉色。",
      "file": "script.rpy",
      "line": 33595
    },
    "10339": {
      "original": "你告诉他们你是粉色和蓝色的粉丝",
      "target": "你说，自己很喜欢粉色和蓝色。",
      "file": "script.rpy",
      "line": 33603
    },
    "10345": {
      "original": "对不起！！这是整个城市最令人垂涎的服装之一！！",
      "target": "拜托！！这可是全城最抢手的衣服之一！！",
      "file": "script.rpy",
      "line": 33621
    },
    "10353": {
      "original": "我是狗的爱好者",
      "target": "我喜欢狗",
      "file": "script.rpy",
      "line": 33640
    },
    "10358": {
      "original": "但我很想有一天见面！！",
      "target": "不过，很想有一天亲眼见见！！",
      "file": "script.rpy",
      "line": 33649
    },
    "10363": {
      "original": "你无情吗？他们太可爱了！！",
      "target": "你没心的吗？它们多可爱啊！！",
      "file": "script.rpy",
      "line": 33663
    },
    "10370": {
      "original": "...鲶鱼不会击中相同的..",
      "target": "……鲶鱼，可不是同一种感觉……",
      "file": "script.rpy",
      "line": 33679
    },
    "10378": {
      "original": "T-听到这个消息真好！！",
      "target": "听、听你这么说，真好！！",
      "file": "script.rpy",
      "line": 33701
    },
    "10386": {
      "original": "你用生动的眼神看着他们",
      "target": "你意味深长地看了对方一眼。",
      "file": "script.rpy",
      "line": 33724
    },
    "10392": {
      "original": "呃。.",
      "target": "呃……",
      "file": "script.rpy",
      "line": 33746
    },
    "10401": {
      "original": "我的意思是,你在惹我,对吧？",
      "target": "我是说，你在逗我，对吧？",
      "file": "script.rpy",
      "line": 33771
    },
    "10402": {
      "original": "哈...哈哈。你抓住我了！！",
      "target": "哈……哈哈，还真被你骗到了！！",
      "file": "script.rpy",
      "line": 33772
    },
    "10421": {
      "original": "请些食物（表示愿意付钱）",
      "target": "提议点餐，并表示愿意付钱",
      "file": "script.rpy",
      "line": 33818
    },
    "10424": {
      "original": "我很感激,但我可以支付账单！",
      "target": "我心领了，不过，我来买单吧！",
      "file": "script.rpy",
      "line": 33825
    },
    "10426": {
      "original": "你等几分钟,等一些食物被叫过来",
      "target": "点完餐，你们等了几分钟。",
      "file": "script.rpy",
      "line": 33827
    },
    "10429": {
      "original": "...你被咬了",
      "target": "……你尝了一口。",
      "file": "script.rpy",
      "line": 33831
    },
    "10433": {
      "original": "我的意思是,我可以付钱——但你至少应该提供！！",
      "target": "我不介意付钱，可你至少也该客气一下吧！！",
      "file": "script.rpy",
      "line": 33842
    },
    "10436": {
      "original": "你看看送来的盘子。你身上几乎没有什么",
      "target": "你看看端来的盘子。你那份，几乎没什么吃的。",
      "file": "script.rpy",
      "line": 33845
    },
    "10437": {
      "original": "... 你们咬了一口,却没有互相说一句话",
      "target": "……你们默默吃着，谁也没说话。",
      "file": "script.rpy",
      "line": 33846
    },
    "10453": {
      "original": "我知道你只是傻了,但别再这样做了,好吗？",
      "target": "我知道，你就是想闹着玩。可别再这样了，好吗？",
      "file": "script.rpy",
      "line": 33884
    },
    "10460": {
      "original": "现在我稍后必须澄清为什么听起来我…… 别这么做！！",
      "target": "现在我还得解释，为什么电话里听起来像是我在……别再这样了！！",
      "file": "script.rpy",
      "line": 33898
    },
    "10468": {
      "original": "很高兴看到你不仅仅忽视我！！",
      "target": "太好了！原来你没有把我当空气！！",
      "file": "script.rpy",
      "line": 33918
    },
    "10477": {
      "original": "保持安静,但是..",
      "target": "小声点，不过……",
      "file": "script.rpy",
      "line": 33957
    },
    "10483": {
      "original": "你几乎没有和主人说过话！！你怎么会知道？？",
      "target": "你都没怎么和老板说过话！！怎么会知道？？",
      "file": "script.rpy",
      "line": 33969
    },
    "10484": {
      "original": "事实上,主人很可爱！！",
      "target": "其实，老板人很好！！",
      "file": "script.rpy",
      "line": 33970
    },
    "10485": {
      "original": "..好吧,你这样取悦我并不是最好的。。",
      "target": "……这么刻意讨好我，也不太管用哦……",
      "file": "script.rpy",
      "line": 33971
    },
    "10487": {
      "original": "你否认主人令人毛骨悚然",
      "target": "你说，不觉得老板吓人。",
      "file": "script.rpy",
      "line": 33979
    },
    "10496": {
      "original": "主人很可爱！他们付了丰厚的报酬并照顾我们！",
      "target": "老板人很好！工资给得大方，也很照顾我们！",
      "file": "script.rpy",
      "line": 34001
    },
    "10502": {
      "original": "...是的,我收集了...",
      "target": "……嗯，我看出来了……",
      "file": "script.rpy",
      "line": 34023
    },
    "10513": {
      "original": "我希望我能和你保持良好的陪伴……",
      "target": "希望我能好好陪着你……",
      "file": "script.rpy",
      "line": 34053
    },
    "10518": {
      "original": "你告诉他们你几乎自由了",
      "target": "你说，自己之后基本都有空。",
      "file": "script.rpy",
      "line": 34069
    },
    "10523": {
      "original": "他们的脸似乎亮了起来",
      "target": "对方的神情，似乎一下明亮起来。",
      "file": "script.rpy",
      "line": 34077
    },
    "10527": {
      "original": "这完全公平。。",
      "target": "好吧，理解……",
      "file": "script.rpy",
      "line": 34087
    },
    "10537": {
      "original": "与你同在的某处",
      "target": "只要有你，哪里都行",
      "file": "script.rpy",
      "line": 34110
    },
    "10543": {
      "original": "首页",
      "target": "家",
      "file": "script.rpy",
      "line": 34123
    },
    "10546": {
      "original": "我想这是公平的",
      "target": "也是，能理解。",
      "file": "script.rpy",
      "line": 34130
    },
    "10551": {
      "original": "你说任何地方都更好,但这里",
      "target": "你说，只要不是这里，哪里都好。",
      "file": "script.rpy",
      "line": 34138
    },
    "10556": {
      "original": "看起来我们今天拥有的所有时间……",
      "target": "看来，今天就只能聊到这里了……",
      "file": "script.rpy",
      "line": 34153
    },
    "10573": {
      "original": "我真的很想见到更多你。。",
      "target": "真想再多见见你。",
      "file": "script.rpy",
      "line": 34198
    },
    "10576": {
      "original": "总有一天会再次回心转意！",
      "target": "有空一定再来！",
      "file": "script.rpy",
      "line": 34203
    },
    "10593": {
      "original": "但是！我目前还不太愿意放弃我的水晶碎片……",
      "target": "不过，我现在还舍不得把水晶碎片给你……",
      "file": "script.rpy",
      "line": 34239
    },
    "10607": {
      "original": "...你给自己记下要洗手",
      "target": "……你提醒自己，等会儿一定得洗手。",
      "file": "script.rpy",
      "line": 34290
    },
    "10618": {
      "original": "你几乎感觉好像可以从内心看到自己的记忆",
      "target": "你几乎觉得，能从里面看见自己的记忆。",
      "file": "script.rpy",
      "line": 34326
    },
    "10629": {
      "original": "向前伸展。",
      "target": "伸出手。",
      "file": "script.rpy",
      "line": 34343
    },
    "10630": {
      "original": "你选择抓住光明并拿走一把……无论核心是由什么制成的。",
      "target": "你把手伸进光里，攥住一把……组成核心的某种东西。",
      "file": "script.rpy",
      "line": 34345
    },
    "10631": {
      "original": "感觉它有一定的价值。",
      "target": "你觉得，它应该很重要。",
      "file": "script.rpy",
      "line": 34346
    },
    "10642": {
      "original": "不过很冷,我会为你加油",
      "target": "不过，没关系，我就在这儿给你加油。",
      "file": "script.rpy",
      "line": 34368
    },
    "10645": {
      "original": "很好的工作",
      "target": "干得漂亮。",
      "file": "script.rpy",
      "line": 34376
    },
    "10654": {
      "original": "我为这个竞技场的音乐做了一些工作！！（产量:3)",
      "target": "这个竞技场的音乐，我也参与制作了！！（负责编曲 :3）",
      "file": "script.rpy",
      "line": 34400
    },
    "10660": {
      "original": "惊人的",
      "target": "太厉害了。",
      "file": "script.rpy",
      "line": 34411
    },
    "10663": {
      "original": "我本来应该为其中一台战斗机器做模特……",
      "target": "本来，有一台战斗机器要照着我做……",
      "file": "script.rpy",
      "line": 34419
    },
    "10668": {
      "original": "... 如果我打了一场仗,我会消灭你……",
      "target": "……要是我也能跟你打，肯定把你打得落花流水……",
      "file": "script.rpy",
      "line": 34429
    },
    "10683": {
      "original": "生病的地方！我确信这里有一些东西你可以拿来",
      "target": "那房子可真酷！我们这儿，肯定有些东西适合摆进去。",
      "file": "script.rpy",
      "line": 34466
    },
    "10686": {
      "original": "老板非常喜欢你卖给我们的那枚闪亮的戒指。他说看起来就像他输了一样。",
      "target": "老板特别喜欢你卖来的钻戒。他说，简直像自己弄丢的那枚。",
      "file": "script.rpy",
      "line": 34472
    },
    "10695": {
      "original": "生病了！这是你的 80,000 日元。",
      "target": "太好了！这是你的 80,000 日元。",
      "file": "script.rpy",
      "line": 34487
    },
    "10724": {
      "original": "你的新房子就在镇顶上。",
      "target": "新房子，就在小镇最北边。",
      "file": "script.rpy",
      "line": 34545
    },
    "10728": {
      "original": "你现在得到的只是一点零钱！来吧,这是一笔好交易,但不是那么好！",
      "target": "这点零钱可不够！我给的价已经很优惠了，可也没优惠到那种地步！",
      "file": "script.rpy",
      "line": 34553
    },
    "10731": {
      "original": "尝试搜索“城镇周围”,也许你会发现一些有价值的东西！",
      "target": "在镇上四处找找，也许能发现有价值的东西！",
      "file": "script.rpy",
      "line": 34559
    },
    "10742": {
      "original": "告诉你吧——如果你能筹集到 50,000 日元,我会给你钥匙并称之为交易。",
      "target": "这样吧，凑到 50,000 日元，我就把钥匙给你，成交！",
      "file": "script.rpy",
      "line": 34574
    },
    "10760": {
      "original": "醒来.",
      "target": "醒来。",
      "file": "script.rpy",
      "line": 34625
    },
    "10775": {
      "original": "你从意识中消失了。。",
      "target": "你渐渐失去了意识……",
      "file": "script.rpy",
      "line": 34676
    },
    "10779": {
      "original": "你留在白天",
      "target": "你走进白昼的光里。",
      "file": "script.rpy",
      "line": 34733
    },
    "10806": {
      "original": "你把外面留下",
      "target": "你回到了外面。",
      "file": "script.rpy",
      "line": 35015
    },
    "10863": {
      "original": "...你觉得你需要首先记住更多...你自己。",
      "target": "……你得先想起更多，关于自己的事。",
      "file": "script.rpy",
      "line": 35670
    },
    "10889": {
      "original": "启动测验抓取工具？！",
      "target": "开始 QuizScraper 挑战？！",
      "file": "script.rpy",
      "line": 35946
    },
    "10932": {
      "original": "这是电梯回到底层",
      "target": "这部电梯，会回到底层。",
      "file": "script.rpy",
      "line": 36152
    },
    "10936": {
      "original": "头往后仰？",
      "target": "回到楼下？",
      "file": "script.rpy",
      "line": 36161
    },
    "10994": {
      "original": "这里有一些浅液体...",
      "target": "这里积着浅浅的一层液体……",
      "file": "script.rpy",
      "line": 36856
    },
    "10995": {
      "original": "它的稠度与您游泳的水不同。",
      "target": "它的质地，与刚才游过的水不同。",
      "file": "script.rpy",
      "line": 36857
    },
    "10998": {
      "original": "你走进浅液体。",
      "target": "你踏进这层浅浅的液体中。",
      "file": "script.rpy",
      "line": 36862
    },
    "10999": {
      "original": "你深入打开的洞里,深入深处。",
      "target": "你潜进打开的洞口，向更深处游去。",
      "file": "script.rpy",
      "line": 36865
    }
